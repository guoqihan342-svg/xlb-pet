                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ScheduledTimeInput}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
