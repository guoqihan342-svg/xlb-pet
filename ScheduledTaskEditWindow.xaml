<Window x:Class="LubanDesktopPet.ScheduledTaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="修改定时任务"
        Width="378"
        Height="208"
        Background="#FFFFF9F2"
        FontFamily="Microsoft YaHei"
        Opacity="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="EditorOrange" Color="#F09A4B" />
        <SolidColorBrush x:Key="EditorOrangeDark" Color="#A85E25" />
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#5B412F" />
            <Setter Property="Background" Value="#FFFFFDFC" />
            <Setter Property="BorderBrush" Value="#F2C995" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="SelectionBrush" Value="#FFD9A9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#F09A4B" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B462A" />
            <Setter Property="Background" Value="#FFFFF8EF" />
            <Setter Property="BorderBrush" Value="#EDBE84" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B462A" />
            <Setter Property="Background" Value="#FFFFF8EF" />
            <Setter Property="BorderBrush" Value="#EDBE84" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectedDateFormat" Value="Short" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A562E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OrangeButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="#F2A052" />
            <Setter Property="BorderBrush" Value="#D98435" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F6B16E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#DB8437" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource OrangeButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFF1E1" />
            <Setter Property="BorderBrush" Value="#EDC494" />
            <Setter Property="Foreground" Value="#A76531" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="OrangeScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="9" Background="Transparent">
                            <Border Width="5"
                                    Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Background="#22E39A55"
                                    CornerRadius="3" />
                            <Track x:Name="PART_Track"
                                   Margin="1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbPill"
                                                        Width="5"
                                                        HorizontalAlignment="Center"
                                                        Background="#E9A15E"
                                                        CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbPill"
                                                                Property="Background"
                                                                Value="#DC8438" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1"
            Padding="8,5,8,7"
            BorderBrush="#E7B77E"
            BorderThickness="1.2"
            CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.62" Color="#FFFFFAF4" />
                <GradientStop Offset="1" Color="#FFFFEEDC" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              Direction="270"
                              Opacity="0.2"
                              ShadowDepth="3"
                              Color="#8E5A32" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="21"
                            Height="21"
                            Margin="0,0,6,0"
                            Background="#FFFFE7CB"
                            BorderBrush="#F1C38D"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="12"
                                   Foreground="#CF7530"
                                   Text="⏰" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#885126"
                               Text="修改定时任务" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="取消修改"
                        Content="×"
                        Style="{StaticResource OrangeCloseButtonStyle}"
                        ToolTip="取消修改"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          CanContentScroll="False"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningDeceleration="0.001"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource OrangeScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="0,1,0,2">
                    <TextBox x:Name="TaskTextBox"
                             Height="42"
                             AcceptsReturn="True"
                             InputMethod.IsInputMethodEnabled="True"
                             MaxLength="5000"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             TextChanged="DraftControl_Changed" />

                    <Grid Height="28" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="43" />
                            <ColumnDefinition Width="11" />
                            <ColumnDefinition Width="43" />
                            <ColumnDefinition Width="11" />
                            <ColumnDefinition Width="43" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="DueDatePicker"
                                    Grid.Column="0"
                                    AutomationProperties.Name="提醒日期"
                                    CalendarClosed="DueDatePicker_CalendarClosed"
                                    CalendarOpened="DueDatePicker_CalendarOpened"
                                    SelectedDateChanged="DraftControl_Changed"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ComboBox x:Name="HourComboBox"
                                  Grid.Column="2"
                                  AutomationProperties.Name="小时"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="DraftControl_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock Grid.Column="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#B0703D"
                                   Text=":" />
                        <ComboBox x:Name="MinuteComboBox"
                                  Grid.Column="4"
                                  AutomationProperties.Name="分钟"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="DraftControl_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock Grid.Column="5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#B0703D"
                                   Text=":" />
                        <ComboBox x:Name="SecondComboBox"
                                  Grid.Column="6"
                                  AutomationProperties.Name="秒"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="DraftControl_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </Grid>

                    <Grid Height="27" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RepeatToggle"
                                  Grid.Column="0"
                                  Content="循环提醒"
                                  Checked="RepeatToggle_Changed"
                                  Unchecked="RepeatToggle_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBox x:Name="RepeatCountTextBox"
                                 Grid.Column="1"
                                 IsEnabled="{Binding IsChecked, ElementName=RepeatToggle}"
                                 MaxLength="7"
                                 PreviewTextInput="RepeatCountTextBox_PreviewTextInput"
                                 TextChanged="DraftControl_Changed"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ComboBox x:Name="RepeatUnitComboBox"
                                  Grid.Column="3"
                                  IsEnabled="{Binding IsChecked, ElementName=RepeatToggle}"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="DraftControl_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock Grid.Column="4"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10"
                                   Foreground="#A56E43"
                                   Text="一次" />
                    </Grid>

                    <TextBlock x:Name="ValidationText"
                               MinHeight="17"
                               Margin="2,1,2,0"
                               FontFamily="Microsoft YaHei"
                               FontSize="9.5"
                               Foreground="#D05B42"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="2,0,8,0"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei"
                           FontSize="9.5"
                           Foreground="#B98A65"
                           Text="点击窗外自动保存 · Esc 取消" />
                <Button Grid.Column="1"
                        MinWidth="82"
                        Height="22"
                        AutomationProperties.Name="确定修改"
                        Content="确定修改"
                        Style="{StaticResource OrangeButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
