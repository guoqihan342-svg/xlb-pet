                        <Popup x:Name="ScheduledTimePickerPopup"
                               AllowsTransparency="True"
                               Closed="ScheduledTimePickerPopup_Closed"
                               HorizontalOffset="-65"
                               Opened="ScheduledTimePickerPopup_Opened"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ScheduledTimePickerHost}"
                               PopupAnimation="Fade"
                               StaysOpen="True"
                               VerticalOffset="5">
                            <Border Width="222"
                                    Padding="12,10,12,11"
                                    Background="#FFFFFCF7"
                                    BorderBrush="#EAB777"
                                    BorderThickness="1"
                                    CornerRadius="15"
                                    PreviewMouseDown="ScheduledPickerPopup_PreviewMouseDown"
                                    PreviewKeyDown="ScheduledTimePickerPopup_PreviewKeyDown"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      Direction="270"
                                                      Opacity="0.18"
                                                      ShadowDepth="3"
                                                      Color="#7A4B2C" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Ellipse Width="13"
                                                         Height="13"
                                                         Canvas.Left="1.5"
                                                         Canvas.Top="1.5"
                                                         Fill="#FFFFE7C8"
                                                         Stroke="#C87534"
                                                         StrokeThickness="1.3" />
                                                <Path Data="M8,4.4 L8,8.1 L10.8,9.7"
                                                      Stroke="#C87534"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.3" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="ScheduledTimePickerTitle"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8B512C"
                                                   Text="选择提醒时间" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="时" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="分" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="秒" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ScheduledHourComboBox"
                                                  Grid.Column="0"
                                                  AutomationProperties.Name="提醒小时"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledMinuteComboBox"
                                                  Grid.Column="2"
                                                  AutomationProperties.Name="提醒分钟"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledSecondComboBox"
                                                  Grid.Column="4"
                                                  AutomationProperties.Name="提醒秒"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Height="28"
                                                Background="#FFFFF0DD"
                                                BorderBrush="#E7B77D"
                                                BorderThickness="1"
                                                Content="现在"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                Foreground="#A45F30"
                                                Click="ScheduledTimePickerNowButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="NowButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NowButtonBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE4C3" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Height="28"
                                                Background="#F2A65A"
                                                BorderThickness="0"
                                                Content="确定"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Click="ScheduledTimePickerConfirmButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ConfirmButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#F6B36F" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#DE8F42" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Height="32" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RepeatToggle"
                                  Grid.Column="0"
                                  AutomationProperties.Name="循环提醒"
                                  Content="循环提醒"
                                  ToolTip="勾选后按天、小时或分钟循环提醒"
                                  Checked="RepeatToggle_Changed"
                                  Unchecked="RepeatToggle_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBox x:Name="RepeatCountTextBox"
                                 Grid.Column="1"
                                 IsEnabled="{Binding IsChecked, ElementName=RepeatToggle}"
                                 MaxLength="7"
                                 Style="{StaticResource CuteRepeatCountTextBoxStyle}"
                                 PreviewTextInput="RepeatCountTextBox_PreviewTextInput"
                                 TextChanged="DraftControl_Changed"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ComboBox x:Name="RepeatUnitComboBox"
                                  Grid.Column="3"
                                  IsEnabled="{Binding IsChecked, ElementName=RepeatToggle}"
                                  Style="{StaticResource CuteRepeatUnitComboBoxStyle}"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="DraftControl_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock Grid.Column="4"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10"
                                   Foreground="#A56E43"
                                   Text="一次" />
                    </Grid>

                    <Grid x:Name="QuietHoursEditor"
                          Height="34"
                          Margin="0,4,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=RepeatToggle}">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=RepeatToggle}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="QuietHoursToggle"
                                  Grid.Column="0"
                                  AutomationProperties.Name="免打扰时段"
                                  Content="免打扰"
                                  ToolTip="勾选后，这个循环任务在免打扰时段内不会弹窗"
                                  Checked="QuietHoursToggle_Changed"
                                  Unchecked="QuietHoursToggle_Changed"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border x:Name="QuietHoursStartPickerHost"
                                Grid.Column="1"
                                Width="75"
                                Height="29"
                                BorderThickness="1"
                                CornerRadius="9"
                                Cursor="Hand"
                                IsEnabled="{Binding IsChecked, ElementName=QuietHoursToggle}"
                                SnapsToDevicePixels="True"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                PreviewMouseLeftButtonDown="QuietHoursTimeInput_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#FFFFF8EE" />
                                    <Setter Property="BorderBrush" Value="#E4C8AA" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QuietHoursStartTextBox}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuietHoursStartTextBox"
                                         Grid.Column="0"
                                         Padding="3,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="免打扰开始时间"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="Transparent"
                                         Cursor="Hand"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="10.5"
                                         Foreground="#7A4B2C"
                                         InputMethod.IsInputMethodEnabled="False"
                                         IsReadOnly="True"
                                         MaxLength="8"
                                         Text="22:00:00"
                                         TextAlignment="Center"
                                         ToolTip="点击选择免打扰开始时间"
                                         PreviewKeyDown="QuietHoursTimeInput_PreviewKeyDown" />
                                <Path Grid.Column="1"
                                      Width="6"
                                      Height="3"
                                      Margin="0,0,4,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L3,3 L6,0"
                                      IsHitTestVisible="False"
                                      Stroke="#B47A4E"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.1" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#B47A4E"
                                   Text="至" />
                        <Border x:Name="QuietHoursEndPickerHost"
                                Grid.Column="3"
                                Width="75"
                                Height="29"
                                BorderThickness="1"
                                CornerRadius="9"
                                Cursor="Hand"
                                IsEnabled="{Binding IsChecked, ElementName=QuietHoursToggle}"
                                SnapsToDevicePixels="True"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                PreviewMouseLeftButtonDown="QuietHoursTimeInput_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#FFFFF8EE" />
                                    <Setter Property="BorderBrush" Value="#E4C8AA" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QuietHoursEndTextBox}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuietHoursEndTextBox"
                                         Grid.Column="0"
                                         Padding="3,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="免打扰结束时间"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="Transparent"
                                         Cursor="Hand"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="10.5"
                                         Foreground="#7A4B2C"
                                         InputMethod.IsInputMethodEnabled="False"
                                         IsReadOnly="True"
                                         MaxLength="8"
                                         Text="07:00:00"
                                         TextAlignment="Center"
                                         ToolTip="点击选择免打扰结束时间；可跨午夜"
                                         PreviewKeyDown="QuietHoursTimeInput_PreviewKeyDown" />
                                <Path Grid.Column="1"
                                      Width="6"
                                      Height="3"
                                      Margin="0,0,4,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L3,3 L6,0"
                                      IsHitTestVisible="False"
                                      Stroke="#B47A4E"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.1" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="QuietHoursOvernightHint"
                                   Grid.Column="4"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10"
                                   Foreground="#C58A5A"
                                   TextTrimming="None"
                                   TextWrapping="NoWrap"
                                   Text="可跨夜" />
                    </Grid>

                    <TextBlock x:Name="ValidationText"
                               MinHeight="17"
                               Margin="2,1,2,0"
                               FontFamily="Microsoft YaHei"
                               FontSize="9.5"
                               Foreground="#D46A2E"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="2,0,8,0"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei"
                           FontSize="9.5"
                           Foreground="#B98A65"
                           Text="仅点击“确定修改”保存 · Esc 取消" />
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        MinWidth="100"
                        Height="38"
                        Padding="14,4"
                        AutomationProperties.Name="确定修改"
                        Content="确定修改"
                        FontSize="13.5"
                        Style="{StaticResource OrangeButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SaveButton_Click" />
            </Grid>

        </Grid>
    </Border>
</Window>
