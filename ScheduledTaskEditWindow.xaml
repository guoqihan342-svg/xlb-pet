                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ScheduledDateInput}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=ScheduledDatePickerPopup}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="13"
                                         Height="13"
                                         Margin="5,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False">
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Width="12.5"
                                                   Height="11.5"
                                                   Canvas.Left="1.75"
                                                   Canvas.Top="2.75"
                                                   RadiusX="2.3"
                                                   RadiusY="2.3"
                                                   Fill="#FFFFE6C6"
                                                   Stroke="#C87534"
                                                   StrokeThickness="1.2" />
                                        <Path Data="M2.2,6.1 L13.8,6.1 M5,1.6 L5,4.2 M11,1.6 L11,4.2"
                                              Stroke="#C87534"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.2" />
                                        <Ellipse Width="1.5"
                                                 Height="1.5"
                                                 Canvas.Left="4.1"
                                                 Canvas.Top="8.1"
                                                 Fill="#D98A45" />
                                        <Ellipse Width="1.5"
                                                 Height="1.5"
                                                 Canvas.Left="7.25"
                                                 Canvas.Top="8.1"
                                                 Fill="#D98A45" />
                                        <Ellipse Width="1.5"
                                                 Height="1.5"
                                                 Canvas.Left="10.4"
                                                 Canvas.Top="8.1"
                                                 Fill="#D98A45" />
                                    </Canvas>
                                </Viewbox>
                                <TextBox x:Name="ScheduledDateInput"
                                         Grid.Column="1"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="提醒日期"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="Transparent"
                                         Cursor="Hand"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="10.8"
                                         Foreground="#7A4B2C"
                                         InputMethod.IsInputMethodEnabled="False"
                                         IsReadOnly="True"
                                         TextAlignment="Center"
                                         ToolTip="点击选择提醒日期，选中后关闭"
                                         PreviewKeyDown="ScheduledDateInput_PreviewKeyDown" />
                                <Path Grid.Column="2"
                                      Width="7"
                                      Height="4"
                                      Margin="0,0,5,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L3.5,3.5 L7,0"
                                      IsHitTestVisible="False"
                                      Stroke="#B47A4E"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Grid>
                        </Border>

                        <Popup x:Name="ScheduledDatePickerPopup"
                               AllowsTransparency="True"
                               Closed="ScheduledDatePickerPopup_Closed"
                               HorizontalOffset="0"
                               Opened="ScheduledDatePickerPopup_Opened"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ScheduledDatePickerHost}"
