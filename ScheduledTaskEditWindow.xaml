                                                Click="ScheduledDatePreviousMonthButton_Click">
                                            <Path Width="6"
                                                  Height="10"
                                                  Data="M6,0 L1,5 L6,10"
                                                  Stroke="#A45F30"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.5" />
                                        </Button>
                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Ellipse Width="5"
                                                     Height="5"
                                                     Margin="0,1,6,0"
                                                     Fill="#F2A65A" />
                                            <TextBlock x:Name="ScheduledDateMonthText"
                                                       FontFamily="Microsoft YaHei"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#8B512C" />
                                        </StackPanel>
                                        <Button x:Name="ScheduledDateNextMonthButton"
                                                Grid.Column="2"
                                                AutomationProperties.Name="下一个月"
                                                Style="{StaticResource ScheduledCalendarNavButtonStyle}"
                                                ToolTip="下一个月"
                                                Click="ScheduledDateNextMonthButton_Click">
                                            <Path Width="6"
                                                  Height="10"
                                                  Data="M0,0 L5,5 L0,10"
                                                  Stroke="#A45F30"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.5" />
                                        </Button>
                                    </Grid>
                                    <UniformGrid Grid.Row="1" Columns="7">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="一" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="二" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="三" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="四" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="五" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#C9826E" Text="六" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#C9826E" Text="日" />
                                    </UniformGrid>
                                    <ItemsControl x:Name="ScheduledDateItemsControl"
                                                  Grid.Row="2"
                                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  SnapsToDevicePixels="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="6" Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="26"
                                                        Margin="1"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontFamily="Microsoft YaHei"
                                                        Tag="{Binding Date}"
                                                        ToolTip="{Binding AccessibleName}"
                                                        Click="ScheduledDateDayButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="ScheduledCalendarDayBorder"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <TextBlock x:Name="ScheduledCalendarDayText"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Microsoft YaHei"
                                                                           FontSize="11.5"
                                                                           Foreground="#75513A"
                                                                           Text="{Binding DayText}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="#BF715C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="#C8BDB2" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#F2A65A" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="Background"
                                                                            Value="#FFFFEBD2" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#F2C58F" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#D98238" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderThickness"
                                                                            Value="1.5" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="Background"
                                                                            Value="#F2A65A" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#E49345" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="White" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Grid.Row="3" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ScheduledDatePickerTodayButton"
                                                Grid.Column="0"
                                                MinWidth="48"
                                                Height="27"
                                                Padding="10,0"
                                                AutomationProperties.Name="选择今天"
                                                Background="#FFFFF0DD"
                                                BorderBrush="#E7B77D"
                                                BorderThickness="1"
                                                Content="今天"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                Foreground="#A45F30"
                                                ToolTip="选择今天并关闭"
                                                Click="ScheduledDatePickerTodayButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ScheduledDateTodayBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ScheduledDateTodayBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE4C3" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ScheduledDateTodayBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFD6A4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10.5"
                                                   Foreground="#B69275"
                                                   Text="点一下就选好啦" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>

                        <Border x:Name="ScheduledTimePickerHost"
                                Grid.Column="2"
                                Height="30"
                                BorderThickness="1"
                                CornerRadius="10"
                                Cursor="Hand"
                                SnapsToDevicePixels="True"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                PreviewMouseLeftButtonDown="ScheduledTimeInput_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFF8EE" />
                                    <Setter Property="BorderBrush" Value="#E4C8AA" />
