<Window x:Class="LubanDesktopPet.ScheduledTaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="修改定时任务"
        Width="378"
        Height="360"
        MinWidth="350"
        MinHeight="320"
        Background="#FFFFF9F2"
        FontFamily="Microsoft YaHei"
        Opacity="0"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="EditorOrange" Color="#F09A4B" />
        <SolidColorBrush x:Key="EditorOrangeDark" Color="#A85E25" />
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#5B412F" />
            <Setter Property="Background" Value="#FFFFFDFC" />
            <Setter Property="BorderBrush" Value="#F2C995" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="SelectionBrush" Value="#FFD9A9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#F09A4B" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B462A" />
            <Setter Property="Background" Value="#FFFFF8EF" />
            <Setter Property="BorderBrush" Value="#EDBE84" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ScheduledTimePartComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="31" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#70462D" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="TimePartBorder"
                                                Background="#FFFFF3DF"
                                                BorderBrush="#E8BE89"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <ContentPresenter Margin="4,0,15,0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem,
                                                                                    RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <Path Width="6"
                                                      Height="3"
                                                      Margin="0,0,6,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L3,3 L6,0"
                                                      Stroke="#B47A4E"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.1" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TimePartBorder"
                                                        Property="Background"
                                                        Value="#FFFFE8C9" />
                                                <Setter TargetName="TimePartBorder"
                                                        Property="BorderBrush"
                                                        Value="#E29B51" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TimePartBorder"
                                                        Property="Background"
                                                        Value="#FFFFE4BE" />
                                                <Setter TargetName="TimePartBorder"
                                                        Property="BorderBrush"
                                                        Value="#DC8D3F" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="176"
                                        Margin="0,3,0,0"
                                        Padding="2"
                                        Background="#FFFFFCF7"
                                        BorderBrush="#EAB777"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                     Handler="ScheduledTimePartItem_PreviewMouseLeftButtonDown" />
                        <Setter Property="Padding" Value="7,4" />
                        <Setter Property="FontFamily" Value="Microsoft YaHei" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="#70462D" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="TimeOptionBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="TimeOptionBorder"
                                                    Property="Background"
                                                    Value="#FFFFEBD2" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TimeOptionBorder"
                                                    Property="Background"
                                                    Value="#FFFFDCA8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScheduledCalendarNavButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Background" Value="#FFFFF0DD" />
            <Setter Property="BorderBrush" Value="#E7B77D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#A45F30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CalendarNavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CalendarNavBorder"
                                        Property="Background"
                                        Value="#FFFFE3C1" />
                                <Setter TargetName="CalendarNavBorder"
                                        Property="BorderBrush"
                                        Value="#E39B50" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CalendarNavBorder"
                                        Property="Background"
                                        Value="#FFFFD6A4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CalendarNavBorder"
                                        Property="BorderBrush"
                                        Value="#D98238" />
                                <Setter TargetName="CalendarNavBorder"
                                        Property="BorderThickness"
                                        Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#8A562E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxShell"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#FFFFF6E9"
                                    BorderBrush="#E7B77D"
                                    BorderThickness="1.2"
                                    CornerRadius="7">
                                <Grid>
                                    <Ellipse Width="8"
                                             Height="3"
                                             Margin="3,2,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#72FFFFFF"
                                             IsHitTestVisible="False" />
                                    <Path x:Name="CheckMark"
                                          Width="11"
                                          Height="8"
                                          Data="M1,4 L4.2,7 L10,1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="Transparent"
                                          Stroke="White"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxShell"
                                        Property="Background"
                                        Value="#FFFFEACF" />
                                <Setter TargetName="CheckBoxShell"
                                        Property="BorderBrush"
                                        Value="#E49649" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxShell"
                                        Property="Background"
                                        Value="#F2A052" />
                                <Setter TargetName="CheckBoxShell"
                                        Property="BorderBrush"
                                        Value="#D98435" />
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBoxShell"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CuteRepeatCountTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFF8EF" />
            <Setter Property="BorderBrush" Value="#EDBE84" />
            <Setter Property="SelectionBrush" Value="#FFD9A9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="RepeatCountBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RepeatCountBorder"
                                        Property="Background"
                                        Value="#FFFFEBCF" />
                                <Setter TargetName="RepeatCountBorder"
                                        Property="BorderBrush"
                                        Value="#E29B51" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RepeatCountBorder"
                                        Property="Background"
                                        Value="#FFFFE6C6" />
                                <Setter TargetName="RepeatCountBorder"
                                        Property="BorderBrush"
                                        Value="#D98A45" />
                                <Setter TargetName="RepeatCountBorder"
                                        Property="BorderThickness"
                                        Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RepeatCountBorder"
                                        Property="Background"
                                        Value="#FFF6F1EA" />
                                <Setter TargetName="RepeatCountBorder"
                                        Property="BorderBrush"
                                        Value="#DFD3C5" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CuteRepeatUnitComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="31" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#70462D" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="RepeatUnitButtonBorder"
                                    Background="#FFFFF3DF"
                                    BorderBrush="#E8BE89"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Grid>
                                    <ContentPresenter Margin="5,1,17,1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding SelectionBoxItem,
                                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <Path Width="6"
                                          Height="3"
                                          Margin="0,0,6,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L3,3 L6,0"
                                          IsHitTestVisible="False"
                                          Stroke="#B47A4E"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.1" />
                                    <ToggleButton Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="176"
                                        Margin="0,3,0,0"
                                        Padding="3"
                                        Background="#FFFFFCF7"
                                        BorderBrush="#EAB777"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          ShadowDepth="2"
                                                          Color="#7A4B2C" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="Background"
                                        Value="#FFFFE8C9" />
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="BorderBrush"
                                        Value="#E29B51" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="Background"
                                        Value="#FFFFEBD2" />
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D98A45" />
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="BorderThickness"
                                        Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="Background"
                                        Value="#FFFFE4BE" />
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="BorderBrush"
                                        Value="#DC8D3F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="Background"
                                        Value="#FFF6F1EA" />
                                <Setter TargetName="RepeatUnitButtonBorder"
                                        Property="BorderBrush"
                                        Value="#DFD3C5" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontFamily" Value="Microsoft YaHei" />
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="Foreground" Value="#70462D" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="RepeatUnitOptionBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                    Property="Background"
                                                    Value="#FFFFEBD2" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                    Property="Background"
                                                    Value="#FFFFDCA8" />
                                            <Setter Property="Foreground" Value="#8A4F21" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="#F2A052" />
            <Setter Property="BorderBrush" Value="#D98435" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F6B16E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#DB8437" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource OrangeButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFF1E1" />
            <Setter Property="BorderBrush" Value="#EDC494" />
            <Setter Property="Foreground" Value="#A76531" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="OrangeCloseCircle"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <Viewbox Width="9"
                                     Height="9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="9" Height="9">
                                    <Path Data="M1.3,1.3 L7.7,7.7 M7.7,1.3 L1.3,7.7"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.4" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OrangeCloseCircle"
                                        Property="Fill"
                                        Value="#FFFFE3C6" />
                                <Setter Property="Foreground"
                                        Value="#C46C2D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OrangeCloseCircle"
                                        Property="Fill"
                                        Value="#FFFFD4A8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="9" Background="Transparent">
                            <Border Width="5"
                                    Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Background="#22E39A55"
                                    CornerRadius="3" />
                            <Track x:Name="PART_Track"
                                   Margin="1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbPill"
                                                        Width="5"
                                                        HorizontalAlignment="Center"
                                                        Background="#E9A15E"
                                                        CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbPill"
                                                                Property="Background"
                                                                Value="#DC8438" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="EditorChrome"
            Margin="0"
            Padding="12,10,12,12"
            BorderBrush="#E7B77E"
            BorderThickness="1.2"
            CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.62" Color="#FFFFFAF4" />
                <GradientStop Offset="1" Color="#FFFFEEDC" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="21"
                            Height="21"
                            Margin="0,0,6,0"
                            Background="#FFFFE7CB"
                            BorderBrush="#F1C38D"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="12"
                                   Foreground="#CF7530"
                                   Text="⏰" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#885126"
                               Text="修改定时任务" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="取消修改"
                        Style="{StaticResource OrangeCloseButtonStyle}"
                        ToolTip="取消修改"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          CanContentScroll="False"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningDeceleration="0.001"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource OrangeScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="2,8,2,6">
                    <TextBox x:Name="TaskTextBox"
                             Height="124"
                             AcceptsReturn="True"
                             InputMethod.IsInputMethodEnabled="True"
                             MaxLength="5000"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             TextChanged="DraftControl_Changed">
                        <TextBox.Style>
                            <Style TargetType="{x:Type TextBox}"
                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="#FFFFF8EF" />
                                <Setter Property="BorderBrush" Value="#F2C995" />
                                <Setter Property="CaretBrush" Value="#A85E25" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="SelectionBrush" Value="#FFD9A9" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TextBox}">
                                            <Border x:Name="TaskBodyBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    SnapsToDevicePixels="True">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="Background"
                                                            Value="#FFFFFAF3" />
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="BorderBrush"
                                                            Value="#F0AE6D" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="Background"
                                                            Value="#FFFFFCF7" />
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="BorderBrush"
                                                            Value="#E89D52" />
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="BorderThickness"
                                                            Value="1.5" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="TaskBodyBorder"
                                                            Property="Opacity"
                                                            Value="0.55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="#FFFFFCF7" />
                                        <Setter Property="BorderBrush" Value="#E89D52" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Grid Height="30" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Compatibility data holder. The visible editor uses
                             the same custom date surface as the add form. -->
                        <DatePicker x:Name="DueDatePicker"
                                    Grid.Column="0"
                                    Visibility="Collapsed"
                                    SelectedDateChanged="DueDatePicker_SelectedDateChanged" />
                        <ComboBox x:Name="HourComboBox"
                                  Grid.Column="3"
                                  Width="1"
                                  Height="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  Opacity="0"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="LegacyTimeComboBox_SelectionChanged" />
                        <ComboBox x:Name="MinuteComboBox"
                                  Grid.Column="3"
                                  Width="1"
                                  Height="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  Opacity="0"
                                  DropDownClosed="InternalComboBox_DropDownClosed"
                                  DropDownOpened="InternalComboBox_DropDownOpened"
                                  SelectionChanged="LegacyTimeComboBox_SelectionChanged" />
                        <ComboBox x:Name="SecondComboBox"
                                  Grid.Column="3"
                                  Width="1"
                                  Height="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  Opacity="0"
