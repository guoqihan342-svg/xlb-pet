                               StaysOpen="True"
                               VerticalOffset="5">
                            <Border Width="236"
                                    Padding="10"
                                    Background="#FFFFFCF7"
                                    BorderBrush="#EAB777"
                                    BorderThickness="1"
                                    CornerRadius="15"
                                    PreviewMouseDown="ScheduledPickerPopup_PreviewMouseDown"
                                    PreviewKeyDown="ScheduledDatePickerPopup_PreviewKeyDown"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      Direction="270"
                                                      Opacity="0.18"
                                                      ShadowDepth="3"
                                                      Color="#7A4B2C" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="31" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="168" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="31" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="31" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ScheduledDatePreviousMonthButton"
