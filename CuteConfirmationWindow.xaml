<Window x:Class="LubanDesktopPet.CuteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="请确认"
        Width="368"
        Height="238"
        Background="Transparent"
        FontFamily="Microsoft YaHei"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ConfirmationButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Background" Value="#FFF8EBDD" />
            <Setter Property="BorderBrush" Value="#E8C39C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#96623C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="ButtonShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Width="18"
                                     Height="5"
                                     Margin="7,4,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Fill="#66FFFFFF"
                                     IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell"
                                        Property="Background"
                                        Value="#FFFFE2C4" />
                                <Setter TargetName="ButtonShell"
                                        Property="BorderBrush"
                                        Value="#E79B57" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonShell"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmationCheckBoxStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#8A6A52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckShell"
                                    Width="19"
                                    Height="19"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#FFFFF8F0"
                                    BorderBrush="#E5B886"
                                    BorderThickness="1.2"
                                    CornerRadius="6">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="7"
                                      Data="M1,3.5 L4,6 L9,1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="Transparent"
                                      Stroke="White"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckShell"
                                        Property="Background"
                                        Value="#FFFFEBD5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckShell"
                                        Property="Background"
                                        Value="#F1A15A" />
                                <Setter TargetName="CheckShell"
                                        Property="BorderBrush"
                                        Value="#D7843A" />
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1"
            Padding="16,12,16,15"
            BorderBrush="#E8B980"
            BorderThickness="1.2"
            CornerRadius="18">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.56" Color="#FFFFFAF3" />
                <GradientStop Offset="1" Color="#FFFFEBD7" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.22"
                              ShadowDepth="4"
                              Color="#80502E" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="27"
                            Height="27"
                            Margin="0,0,8,0"
                            Background="#FFFFE5C7"
                            BorderBrush="#EDB270"
                            BorderThickness="1"
                            CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="15"
                                   Foreground="#D57C32"
                                   Text="?" />
                    </Border>
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#86512C"
                               Text="请确认" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="27"
                        Height="27"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="取消"
                        FontFamily="Microsoft YaHei"
                        FontSize="17"
                        Style="{StaticResource ConfirmationButtonStyle}"
                        ToolTip="取消"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click">
                    <Viewbox Width="10"
                             Height="10"
                             IsHitTestVisible="False">
                        <Canvas Width="10" Height="10">
                            <Path Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,8"
                    Padding="13,11"
                    Background="#B3FFFFFF"
                    BorderBrush="#F0D5B7"
                    BorderThickness="1"
                    CornerRadius="13">
                <TextBlock x:Name="MessageText"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei"
                           FontSize="12.5"
                           Foreground="#5D493A"
                           LineHeight="22"
                           Text="确定要继续吗？"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <CheckBox x:Name="SessionSuppressionCheckBox"
                      Grid.Row="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="本次运行不再提示"
                      Content="本次运行不再提示"
                      IsChecked="False"
                      Style="{StaticResource ConfirmationCheckBoxStyle}"
                      ToolTip="只在本次启动期间生效，不会写入设置" />

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.Name="取消"
                        Content="再想想"
                        Style="{StaticResource ConfirmationButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="2"
                        AutomationProperties.Name="确认"
                        Background="#F09A4B"
                        BorderBrush="#D77B2B"
                        Content="确认"
                        Foreground="White"
                        Style="{StaticResource ConfirmationButtonStyle}"
                        Click="ConfirmButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
