<Window x:Class="LubanDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班桌宠"
        Width="454"
        Height="454"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BubbleColumn" Width="0" />
            <ColumnDefinition x:Name="GapColumn" Width="0" />
            <ColumnDefinition x:Name="PetColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Popup x:Name="BubblePopup"
               Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Opened="BubblePopup_Opened"
               Placement="Left"
               PlacementTarget="{Binding ElementName=PetSizeViewbox}"
               StaysOpen="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BubbleBodyColumn" Width="Auto" />
                    <ColumnDefinition x:Name="BubbleTailColumn" Width="12" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="BubbleHost"
                      Grid.Column="0"
                      Visibility="Collapsed">
                    <Border x:Name="CuteBubble"
                            Width="215"
                            Height="76"
                            Padding="16,12"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="Collapsed">
                        <TextBlock x:Name="CuteMessageText"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="14"
                                   Foreground="#303744"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="ReminderBubble"
                            Width="270"
                            Height="148"
                            Padding="15,11,15,10"
                            VerticalAlignment="Bottom"
                            BorderBrush="#E9AD3C"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFFFFEF7" />
                                <GradientStop Offset="1" Color="#FFFFF2C9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Border Width="24"
                                        Height="24"
                                        Margin="0,0,7,0"
                                        Background="#FFFFD866"
                                        BorderBrush="#E7A83B"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#8B4B24"
                                               Text="!" />
                                </Border>
                                <TextBlock x:Name="ReminderTitleText"
                                           VerticalAlignment="Center"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#77421F"
                                           Text="定时任务到点啦" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,3,0,5"
                                    Padding="8,4"
                                    Background="#FFFFFCF2"
                                    BorderBrush="#F3D99C"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBox x:Name="ReminderMessageText"
                                         Padding="0"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Top"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Cursor="IBeam"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="13"
                                         Foreground="#543C2F"
                                         IsReadOnly="True"
                                         SelectionBrush="#9ED2FF"
                                         TextAlignment="Left"
                                         TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <Button x:Name="ReminderAcknowledgeButton"
                                    Grid.Row="2"
                                    MinWidth="82"
                                    MaxWidth="132"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="#FF7F6A"
                                    BorderBrush="#D85848"
                                    BorderThickness="1"
                                    Click="ReminderAcknowledgeButton_Click"
                                    Cursor="Hand"
                                    FontFamily="Microsoft YaHei"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Content="知道啦">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="#FF917F" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="#EA6654" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="BubbleTailHost"
                      Grid.Column="1"
                      Margin="-1,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Polygon x:Name="BubbleTailPolygon"
                             Points="0,0 12,9 0,18"
                             Fill="White"
                             Stroke="#D8DEE8"
                             StrokeThickness="1" />
                </Grid>
            </Grid>
        </Popup>

        <Grid x:Name="PetHost"
              Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Cursor="Hand"
              ToolTip="左键互动或拖动，右键打开待办；打工时双击加速并进入认真状态"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp"
              LostMouseCapture="PetHost_LostMouseCapture"
              PreviewMouseRightButtonDown="PetHost_PreviewMouseRightButtonDown"
              MouseRightButtonUp="PetHost_MouseRightButtonUp">
            <Viewbox x:Name="PetSizeViewbox"
                     Width="190"
                     Height="242"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     RenderTransformOrigin="0.5,1"
                     RenderOptions.BitmapScalingMode="Fant"
                     UseLayoutRounding="False"
                     Stretch="Fill">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetUserSizeScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetUserSizeOffset" X="0" Y="0" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
            <Grid x:Name="PetVisual"
                  Width="190"
                  Height="242"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5371900826446281">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetFacingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetRoamRotate" Angle="0" />
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Canvas x:Name="PetFrameViewport"
                        Width="190"
                        Height="242"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Image x:Name="PillowImage"
                           Width="190"
                           Height="242"
                           Source="/LubanDesktopPet;component/Assets/luban-pillow-layer.png"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Fant" />
                    <Rectangle x:Name="PetImage"
                               Width="190"
                               Height="242"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Fant">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="PetSpriteBrush"
                                        Viewbox="0,0,399,509"
                                        ViewboxUnits="Absolute"
                                        Stretch="Fill"
                                        AlignmentX="Left"
                                        AlignmentY="Top" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Image x:Name="WishStarOverlay"
                           Width="22"
                           Height="22"
                           Canvas.Left="84"
                           Canvas.Top="172"
                           Panel.ZIndex="10"
                           IsHitTestVisible="False"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5"
                           SnapsToDevicePixels="False"
                           Source="/LubanDesktopPet;component/Assets/luban-wish-star.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Fant">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="WishStarScale"
                                                ScaleX="1"
                                                ScaleY="1" />
                                <RotateTransform x:Name="WishStarRotate"
                                                 Angle="0" />
                                <TranslateTransform x:Name="WishStarTranslate"
                                                    X="0"
                                                    Y="0" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Grid x:Name="SnoreBubbleHost"
                          Width="17"
                          Height="16"
                          Canvas.Left="59"
                          Canvas.Top="177"
                          IsHitTestVisible="False"
                          Opacity="0"
                          RenderTransformOrigin="0.88,0.52"
                          SnapsToDevicePixels="False">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SnoreBubbleScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#78AFC8D2"
                                 StrokeThickness="0.7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.34,0.30"
                                                     GradientOrigin="0.25,0.22"
                                                     RadiusX="0.78"
                                                     RadiusY="0.78">
                                    <GradientStop Offset="0"
                                                  Color="#72FFFFFF" />
                                    <GradientStop Offset="0.58"
                                                  Color="#58F1F8FA" />
                                    <GradientStop Offset="1"
                                                  Color="#3CD9E9ED" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Canvas>

                <Button x:Name="WorkModeButton"
                        Width="42"
                        Height="42"
                        Margin="6,6,6,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        AutomationProperties.HelpText="太阳图标，点击让小鲁班去打工"
                        AutomationProperties.Name="去打工"
                        Cursor="Hand"
                        Focusable="False"
                        FontFamily="Microsoft YaHei"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        Tag="Idle"
                        ToolTip="太阳：去打工"
                        Visibility="Collapsed"
                        Click="WorkModeButton_Click">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="WorkModeFacingCompensation"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="WorkIconRoot"
                                  Width="42"
                                  Height="42"
                                  Background="Transparent"
                                  SnapsToDevicePixels="False">
                                <Ellipse x:Name="WorkIconHoverHalo"
                                         Width="40"
                                         Height="40"
                                         Fill="#42FFF2C9"
                                         Opacity="0" />

                                <Ellipse x:Name="WorkSunModeHalo"
                                         Width="36"
                                         Height="31"
                                         IsHitTestVisible="False"
                                         Opacity="0.30"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.58"
                                                             GradientOrigin="0.5,0.58"
                                                             RadiusX="0.56"
                                                             RadiusY="0.56">
                                            <GradientStop Offset="0" Color="#72FFF0A4" />
                                            <GradientStop Offset="0.66" Color="#36FFD46D" />
                                            <GradientStop Offset="1" Color="#00FFD46D" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="WorkSunModeHaloScale"
                                                        ScaleX="1"
                                                        ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Ellipse x:Name="WorkMoonModeHalo"
                                         Width="36"
                                         Height="31"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.58"
                                                             GradientOrigin="0.5,0.58"
                                                             RadiusX="0.56"
                                                             RadiusY="0.56">
                                            <GradientStop Offset="0" Color="#6EDFD4FF" />
                                            <GradientStop Offset="0.66" Color="#369E8CEB" />
                                            <GradientStop Offset="1" Color="#009E8CEB" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="WorkMoonModeHaloScale"
                                                        ScaleX="0.86"
                                                        ScaleY="0.86" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Viewbox x:Name="SunIcon"
                                         Width="32"
                                         Height="32"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Opacity="1"
                                         RenderTransformOrigin="0.5,0.5"
                                         Visibility="Visible">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="WorkSunIconScale"
                                                            ScaleX="1"
                                                            ScaleY="1" />
                                            <RotateTransform x:Name="WorkSunIconRotate"
                                                             Angle="0" />
                                            <TranslateTransform x:Name="WorkSunIconTranslate"
                                                                X="0"
                                                                Y="0" />
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="32" Height="32">
                                        <Path Data="M16,1.5 V5 M16,27 V30.5 M1.5,16 H5 M27,16 H30.5 M5.7,5.7 L8.2,8.2 M23.8,23.8 L26.3,26.3 M26.3,5.7 L23.8,8.2 M8.2,23.8 L5.7,26.3"
                                              Stroke="#F3A641"
                                              StrokeEndLineCap="Round"
                                              StrokeThickness="2.7" />
                                        <Ellipse Width="22"
                                                 Height="22"
                                                 Canvas.Left="5"
                                                 Canvas.Top="5"
                                                 Stroke="#E79A35"
                                                 StrokeThickness="1.2">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.38,0.32"
                                                                     GradientOrigin="0.32,0.26"
                                                                     RadiusX="0.72"
                                                                     RadiusY="0.72">
                                                    <GradientStop Offset="0" Color="#FFFFF4A8" />
                                                    <GradientStop Offset="1" Color="#FFFFC853" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="2.5" Height="3.2"
                                                 Canvas.Left="10.8" Canvas.Top="12.1"
                                                 Fill="#7A4A32" />
                                        <Ellipse Width="2.5" Height="3.2"
                                                 Canvas.Left="18.7" Canvas.Top="12.1"
                                                 Fill="#7A4A32" />
                                        <Ellipse Width="3.4" Height="2.1"
                                                 Canvas.Left="7.8" Canvas.Top="16.2"
                                                 Fill="#8EF79A9A" />
                                        <Ellipse Width="3.4" Height="2.1"
                                                 Canvas.Left="20.8" Canvas.Top="16.2"
                                                 Fill="#8EF79A9A" />
                                        <Path Data="M11.8,18.4 C13.7,21.1 18.3,21.1 20.2,18.4"
                                              Fill="Transparent"
                                              Stroke="#7A4A32"
                                              StrokeEndLineCap="Round"
                                              StrokeThickness="1.3" />
                                    </Canvas>
                                </Viewbox>

                                <Viewbox x:Name="MoonIcon"
                                         Width="32"
                                         Height="32"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5"
                                         Visibility="Visible">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="WorkMoonIconScale"
                                                            ScaleX="0.72"
                                                            ScaleY="0.72" />
                                            <RotateTransform x:Name="WorkMoonIconRotate"
                                                             Angle="16" />
                                            <TranslateTransform x:Name="WorkMoonIconTranslate"
                                                                X="1.8"
                                                                Y="3.4" />
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="32" Height="32">
                                        <Path Data="M21.8,3.3 C14.2,4.2 9,10.3 9.3,17.3 C9.6,24.7 16.3,29.1 23.4,27.1 C17.7,24.9 14.5,19.7 15.2,14.2 C15.8,9.5 18.4,5.7 21.8,3.3 Z"
                                              Stroke="#E6A84B"
                                              StrokeLineJoin="Round"
                                              StrokeThickness="1.2">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#FFFFF7C7" />
                                                    <GradientStop Offset="1" Color="#FFFFD86B" />
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Path Data="M18.1,12.8 C19,11.9 20.2,11.9 21.1,12.8 M17.6,19.1 C18.9,20.8 21.1,20.8 22.4,19.1"
                                              Fill="Transparent"
                                              Stroke="#745066"
                                              StrokeEndLineCap="Round"
                                              StrokeThickness="1.15" />
                                        <Ellipse Width="3.1" Height="1.9"
                                                 Canvas.Left="14.8" Canvas.Top="15.5"
                                                 Fill="#83F7A0A5" />
                                        <Path Data="M25.6,5.1 L26.4,7 L28.4,7.5 L26.8,8.8 L27,10.9 L25.3,9.8 L23.5,10.7 L24,8.7 L22.5,7.3 L24.6,7.1 Z"
                                              Fill="#8D7FD4" />
                                        <Path Data="M5.8,9.6 L6.4,10.9 L7.9,11.2 L6.8,12.2 L6.9,13.7 L5.6,13 L4.3,13.6 L4.6,12.1 L3.6,11.1 L5,10.9 Z"
                                              Fill="#A79AE7" />
                                    </Canvas>
                                </Viewbox>

                                <Path x:Name="WorkIconTwinkle"
                                      Width="10"
                                      Height="10"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,2,2,0"
                                      Data="M5,0.5 L6.15,3.85 L9.5,5 L6.15,6.15 L5,9.5 L3.85,6.15 L0.5,5 L3.85,3.85 Z"
                                      Fill="#FFFFF4B7"
                                      IsHitTestVisible="False"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5"
                                      Stroke="#D9F6AE55"
                                      StrokeThickness="0.55">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="WorkIconTwinkleScale"
                                                            ScaleX="0.55"
                                                            ScaleY="0.55" />
                                            <RotateTransform x:Name="WorkIconTwinkleRotate"
                                                             Angle="-15" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Working">
                                    <Setter TargetName="WorkIconHoverHalo"
                                            Property="Fill"
                                            Value="#3EDFD4FF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="WorkIconHoverHalo"
                                            Property="Opacity"
                                            Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="WorkIconRoot"
                                            Property="Opacity"
                                            Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="WorkIconRoot"
                                            Property="Opacity"
                                            Value="0.78" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
