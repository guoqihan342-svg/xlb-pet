<Window x:Class="LubanDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班桌宠"
        Width="190"
        Height="242"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BubbleColumn" Width="0" />
            <ColumnDefinition x:Name="GapColumn" Width="0" />
            <ColumnDefinition x:Name="PetColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Popup x:Name="BubblePopup"
               Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Placement="Left"
               PlacementTarget="{Binding ElementName=PetHost}"
               StaysOpen="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="BubbleHost"
                      Grid.Column="0"
                      Visibility="Collapsed">
            <Border x:Name="CuteBubble"
                    Width="215"
                    Height="76"
                    Padding="16,12"
                    VerticalAlignment="Bottom"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed">
                <TextBlock x:Name="CuteMessageText"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei"
                           FontSize="14"
                           Foreground="#303744"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

                </Grid>

        <Grid x:Name="BubbleTailHost"
               Grid.Column="1"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Visibility="Collapsed">
            <Polygon Points="0,0 12,9 0,18"
                     Fill="White"
                      Stroke="#D8DEE8"
                      StrokeThickness="1" />
        </Grid>
            </Grid>
        </Popup>

        <Grid x:Name="PetHost"
              Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Cursor="Hand"
              ToolTip="左键卖萌或拖动，右键打开待办"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp"
              LostMouseCapture="PetHost_LostMouseCapture"
              MouseRightButtonUp="PetHost_MouseRightButtonUp">
            <Viewbox x:Name="PetSizeViewbox"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     RenderTransformOrigin="0.5,1"
                     RenderOptions.BitmapScalingMode="Fant"
                     UseLayoutRounding="False"
                     Stretch="Fill">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetUserSizeScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetUserSizeOffset" X="0" Y="0" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
            <Grid x:Name="PetVisual"
                  Width="190"
                  Height="242"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.72">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetFacingScale" ScaleX="1" ScaleY="1" />
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Canvas x:Name="PetFrameViewport"
                        Width="190"
                        Height="242"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Rectangle x:Name="PetImage"
                               Width="190"
                               Height="242"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Fant">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="PetSpriteBrush"
                                        Viewbox="0,0,399,509"
                                        ViewboxUnits="Absolute"
                                        Stretch="Fill"
                                        AlignmentX="Left"
                                        AlignmentY="Top" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Canvas>
            </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
