<Window x:Class="LubanDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班桌宠"
        Width="145"
        Height="185"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BubbleColumn" Width="0" />
            <ColumnDefinition x:Name="GapColumn" Width="0" />
            <ColumnDefinition Width="145" />
        </Grid.ColumnDefinitions>

        <Popup x:Name="BubblePopup"
               Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Placement="Left"
               PlacementTarget="{Binding ElementName=PetHost}"
               StaysOpen="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="BubbleHost"
                      Grid.Column="0"
                      Visibility="Collapsed">
            <Border x:Name="CuteBubble"
                    Width="215"
                    Height="76"
                    Padding="16,12"
                    VerticalAlignment="Bottom"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed">
                <TextBlock x:Name="CuteMessageText"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="14"
                           Foreground="#303744"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <Border x:Name="TodoBubble"
                    Width="280"
                    Height="232"
                    Padding="14"
                    VerticalAlignment="Bottom"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#202631"
                                   Text="待办事项" />
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="8,3"
                                Background="#F1F3F6"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontFamily="Microsoft YaHei UI"
                                Foreground="#515966"
                                Content="收起"
                                Click="CloseTodoButton_Click" />
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                Padding="8,3"
                                Background="#FFF0F0"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontFamily="Microsoft YaHei UI"
                                Foreground="#C04444"
                                Content="退出"
                                Click="ExitButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TodoItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="7,6"
                                                Background="#F6F7F9"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Margin="0,0,7,0"
                                                          VerticalAlignment="Center"
                                                          Cursor="Hand"
                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="TodoCheckBox_Click" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Microsoft YaHei UI"
                                                           FontSize="13"
                                                           Text="{Binding Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#303744" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#9097A3" />
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="2"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="16"
                                                        Foreground="#A0A6B0"
                                                        Content="×"
                                                        Tag="{Binding}"
                                                        Click="DeleteTodoButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="13"
                                   Foreground="#9AA1AC"
                                   IsHitTestVisible="False"
                                   Text="还没有待办，写下一件事吧">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=TodoItemsControl}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TodoInput"
                                 Grid.Column="0"
                                 Margin="0,0,7,0"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D8DEE8"
                                 FontFamily="Microsoft YaHei UI"
                                 FontSize="13"
                                 MaxLength="80"
                                 ToolTip="输入待办事项，按回车添加"
                                 KeyDown="TodoInput_KeyDown" />
                        <Button Grid.Column="1"
                                Background="#5B8DEF"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontFamily="Microsoft YaHei UI"
                                Foreground="White"
                                Content="新增"
                                Click="AddTodoButton_Click" />
                    </Grid>
                </Grid>
            </Border>
                </Grid>

        <Grid x:Name="BubbleTailHost"
               Grid.Column="1"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Visibility="Collapsed">
            <Polygon Points="0,0 12,9 0,18"
                     Fill="White"
                      Stroke="#D8DEE8"
                      StrokeThickness="1" />
        </Grid>
            </Grid>
        </Popup>

        <Grid x:Name="PetHost"
              Grid.Column="2"
              Width="145"
              Height="185"
              VerticalAlignment="Bottom"
              Background="Transparent"
              Cursor="Hand"
              ToolTip="左键卖萌或拖动，右键打开待办"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp"
              LostMouseCapture="PetHost_LostMouseCapture"
              MouseRightButtonUp="PetHost_MouseRightButtonUp">
            <Grid x:Name="PetVisual"
                  RenderTransformOrigin="0.5,0.72">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Image x:Name="PetImage"
                       Margin="2"
                       CacheMode="BitmapCache"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="PetImageOverlay"
                       Margin="2"
                       CacheMode="BitmapCache"
                       Opacity="0"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Grid>
    </Grid>
</Window>
