<Window x:Class="LubanDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班桌宠"
        Width="454"
        Height="454"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BubbleColumn" Width="0" />
            <ColumnDefinition x:Name="GapColumn" Width="0" />
            <ColumnDefinition x:Name="PetColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Popup x:Name="BubblePopup"
               Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Opened="BubblePopup_Opened"
               Placement="Left"
               PlacementTarget="{Binding ElementName=PetSizeViewbox}"
               StaysOpen="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BubbleBodyColumn" Width="Auto" />
                    <ColumnDefinition x:Name="BubbleTailColumn" Width="12" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="BubbleHost"
                      Grid.Column="0"
                      Visibility="Collapsed">
                    <Border x:Name="CuteBubble"
                            Width="215"
                            Height="76"
                            Padding="16,12"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="Collapsed">
                        <TextBlock x:Name="CuteMessageText"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="14"
                                   Foreground="#303744"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="ReminderBubble"
                            Width="270"
                            Height="148"
                            Padding="15,11,15,10"
                            VerticalAlignment="Bottom"
                            BorderBrush="#E9AD3C"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFFFFEF7" />
                                <GradientStop Offset="1" Color="#FFFFF2C9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Border Width="24"
                                        Height="24"
                                        Margin="0,0,7,0"
                                        Background="#FFFFD866"
                                        BorderBrush="#E7A83B"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#8B4B24"
                                               Text="!" />
                                </Border>
                                <TextBlock x:Name="ReminderTitleText"
                                           VerticalAlignment="Center"
                                           FontFamily="Microsoft YaHei"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#77421F"
                                           Text="定时任务到点啦" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,3,0,5"
                                    Padding="8,4"
                                    Background="#FFFFFCF2"
                                    BorderBrush="#F3D99C"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBox x:Name="ReminderMessageText"
                                         Padding="0"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Top"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Cursor="IBeam"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="13"
                                         Foreground="#543C2F"
                                         IsReadOnly="True"
                                         SelectionBrush="#9ED2FF"
                                         TextAlignment="Left"
                                         TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <Button x:Name="ReminderAcknowledgeButton"
                                    Grid.Row="2"
                                    MinWidth="82"
                                    MaxWidth="132"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="#FF7F6A"
                                    BorderBrush="#D85848"
                                    BorderThickness="1"
                                    Click="ReminderAcknowledgeButton_Click"
                                    Cursor="Hand"
                                    FontFamily="Microsoft YaHei"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Content="知道啦">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="#FF917F" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                                        Property="Background"
                                                        Value="#EA6654" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="BubbleTailHost"
                      Grid.Column="1"
                      Margin="-1,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Polygon x:Name="BubbleTailPolygon"
                             Points="0,0 12,9 0,18"
                             Fill="White"
                             Stroke="#D8DEE8"
                             StrokeThickness="1" />
                </Grid>
            </Grid>
        </Popup>

        <Grid x:Name="PetHost"
              Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Cursor="Hand"
              ToolTip="左键互动或拖动，右键打开待办；打工时双击加速并进入认真状态"
              MouseLeftButtonDown="PetHost_MouseLeftButtonDown"
              MouseMove="PetHost_MouseMove"
              MouseLeftButtonUp="PetHost_MouseLeftButtonUp"
              LostMouseCapture="PetHost_LostMouseCapture"
              PreviewMouseRightButtonDown="PetHost_PreviewMouseRightButtonDown"
              MouseRightButtonUp="PetHost_MouseRightButtonUp">
            <Viewbox x:Name="PetSizeViewbox"
                     Width="190"
                     Height="242"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     RenderTransformOrigin="0.5,1"
                     RenderOptions.BitmapScalingMode="Fant"
                     UseLayoutRounding="False"
                     Stretch="Fill">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetUserSizeScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetUserSizeOffset" X="0" Y="0" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
            <Grid x:Name="PetVisual"
                  Width="190"
                  Height="242"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5371900826446281">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetFacingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetRoamRotate" Angle="0" />
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Canvas x:Name="PetFrameViewport"
                        Width="190"
                        Height="242"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Image x:Name="PillowImage"
                           Width="190"
                           Height="242"
                           Source="/LubanDesktopPet;component/Assets/luban-pillow-layer.png"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Fant" />
                    <Rectangle x:Name="PetImage"
                               Width="190"
                               Height="242"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Fant">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="PetSpriteBrush"
                                        Viewbox="0,0,399,509"
                                        ViewboxUnits="Absolute"
                                        Stretch="Fill"
                                        AlignmentX="Left"
                                        AlignmentY="Top" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid x:Name="SnoreBubbleHost"
                          Width="17"
                          Height="16"
                          Canvas.Left="59"
                          Canvas.Top="177"
                          IsHitTestVisible="False"
                          Opacity="0"
                          RenderTransformOrigin="0.88,0.52"
                          SnapsToDevicePixels="False">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SnoreBubbleScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#78AFC8D2"
                                 StrokeThickness="0.7">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.34,0.30"
                                                     GradientOrigin="0.25,0.22"
                                                     RadiusX="0.78"
                                                     RadiusY="0.78">
                                    <GradientStop Offset="0"
                                                  Color="#72FFFFFF" />
                                    <GradientStop Offset="0.58"
                                                  Color="#58F1F8FA" />
                                    <GradientStop Offset="1"
                                                  Color="#3CD9E9ED" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Canvas>

                <Button x:Name="WorkModeButton"
                        Width="92"
                        Height="28"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        AutomationProperties.Name="切换打工状态"
                        Cursor="Hand"
                        Content="去打工"
                        Focusable="False"
                        FontFamily="Microsoft YaHei"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        Tag="Idle"
                        ToolTip="待机时去打工；打工时点击去睡觉"
                        Click="WorkModeButton_Click">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="WorkModeFacingCompensation"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="WorkButtonChrome"
                                    BorderBrush="#E9A95F"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="0,1">
                                        <GradientStop Offset="0"
                                                      Color="#FFFFFCF3" />
                                        <GradientStop Offset="1"
                                                      Color="#FFFFE8C5" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15"
                                             Height="14"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False">
                                        <Canvas Width="16"
                                                Height="15">
                                            <Path Data="M1.5,1.5 H14.5 V10 H1.5 Z M5,10 V12.2 M11,10 V12.2 M3.2,13 H12.8 M2,14 H14"
                                                  Fill="Transparent"
                                                  Stroke="#A8612E"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeThickness="1.45" />
                                            <Ellipse Width="1.5"
                                                     Height="1.5"
                                                     Canvas.Left="7.25"
                                                     Canvas.Top="5"
                                                     Fill="#F09B46" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1"
                                               Margin="5,0,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#925227"
                                               IsHitTestVisible="False"
                                               Text="{TemplateBinding Content}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="WorkButtonChrome"
                                            Property="Background"
                                            Value="#FFFFF2D9" />
                                    <Setter TargetName="WorkButtonChrome"
                                            Property="BorderBrush"
                                            Value="#F08F43" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="WorkButtonChrome"
                                            Property="Background"
                                            Value="#FFFFDCA6" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="WorkButtonChrome"
                                            Property="Opacity"
                                            Value="0.68" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
