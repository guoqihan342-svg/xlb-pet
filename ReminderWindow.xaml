<Window x:Class="LubanDesktopPet.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班提醒"
        Width="372"
        Height="468"
        MaxHeight="468"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Closing="ReminderWindow_Closing"
        DpiChanged="ReminderWindow_DpiChanged"
        PreviewKeyDown="ReminderWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CuteReminderScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="13" />
            <Setter Property="MinWidth" Value="13" />
            <Setter Property="Margin" Value="2,1,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <Border x:Name="ReminderTrackPill"
                                    Width="9"
                                    Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Background="#45F2B77B"
                                    BorderBrush="#68E49A52"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Track x:Name="PART_Track"
                                   Margin="1,3"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="30"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="ReminderThumbPill"
                                                            Width="9"
                                                            Margin="0,1"
                                                            HorizontalAlignment="Center"
                                                            Background="#F3A45E"
                                                            BorderBrush="#D9823A"
                                                            BorderThickness="1"
                                                            CornerRadius="5">
                                                        <Grid>
                                                            <Ellipse Width="3"
                                                                     Height="3"
                                                                     Margin="2,5,0,0"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Top"
                                                                     Fill="#BFFFFFFF" />
                                                            <Ellipse Width="2"
                                                                     Height="2"
                                                                     Margin="0,9,2,0"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Fill="#80FFFFFF" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ReminderThumbPill"
                                                                Property="Background"
                                                                Value="#ED9148" />
                                                        <Setter TargetName="ReminderThumbPill"
                                                                Property="Width"
                                                                Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ReminderThumbPill"
                                                                Property="Background"
                                                                Value="#DC7A32" />
                                                        <Setter TargetName="ReminderThumbPill"
                                                                Property="Width"
                                                                Value="11" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ReminderTrackPill"
                                        Property="Background"
                                        Value="#72F2B77B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CuteReminderPageButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFF1E2" />
            <Setter Property="BorderBrush" Value="#F0B477" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#C66F2D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PageButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PageButtonBackground"
                                        Property="Background"
                                        Value="#FFE2C4" />
                                <Setter Property="BorderBrush"
                                        Value="#E79A51" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PageButtonBackground"
                                        Property="Background"
                                        Value="#F8CC9F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PageButtonBackground"
                                        Property="Background"
                                        Value="#FFF8F1" />
                                <Setter Property="BorderBrush"
                                        Value="#F4D8BC" />
                                <Setter Property="Foreground"
                                        Value="#D9B99B" />
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border Background="#FFF9F2"
                BorderBrush="#F2C08E"
                BorderThickness="1"
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Color="#A7662D"
                                  Direction="270"
                                  Opacity="0.22"
                                  ShadowDepth="4" />
            </Border.Effect>

            <Grid Margin="16,14,16,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFF0C86A"
                            CornerRadius="16">
                        <Grid>
                            <Path Width="15"
                                  Height="16"
                                  Data="M7.5,1 C5.2,1 3.6,2.8 3.6,5.2 L3.6,8.4 L1.8,11.2 L13.2,11.2 L11.4,8.4 L11.4,5.2 C11.4,2.8 9.8,1 7.5,1 Z M5.7,12.3 C6,13.7 6.6,14.5 7.5,14.5 C8.4,14.5 9,13.7 9.3,12.3"
                                  Fill="#FFFDF7E7"
                                  Stretch="Fill"
                                  Stroke="#B77B2E"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.15" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="2,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ReminderTitleText"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#7E4A27"
                                   Text="小鲁班提醒"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#B17A50"
                                   Text="到时间啦，记得看看这些事情哦" />
                    </StackPanel>

                    <Button x:Name="ReminderCloseButton"
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="关闭提醒"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei"
                            FontSize="17"
                            Foreground="#C38352"
                            ToolTip="关闭并清空本批提醒"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBackground"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="13">
                                                <Viewbox Width="10"
                                                         Height="10"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="10" Height="10">
                                                        <Path Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5"
                                                              Fill="Transparent"
                                                              Stroke="{TemplateBinding Foreground}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBackground"
                                                            Property="Background"
                                                            Value="#FFF0E2" />
                                                    <Setter Property="Foreground"
                                                            Value="#A95E27" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CloseBackground"
                                                            Property="Background"
                                                            Value="#FFE1C7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,11,0,8"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Background="#FFF0DE"
                        CornerRadius="10">
                    <TextBlock x:Name="ReminderCountText"
                               FontFamily="Microsoft YaHei"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#C66F2D"
                               Text="0 条提醒" />
                </Border>

                <TextBox x:Name="ReminderContentTextBox"
                         Grid.Row="2"
                         MinHeight="0"
                         Padding="11,9"
                         AcceptsReturn="True"
                         AutomationProperties.Name="提醒内容"
                         Background="#FFFCF8"
                         BorderBrush="#F4C99D"
                         BorderThickness="1"
                         FontFamily="Microsoft YaHei"
                         FontSize="12.5"
                         Foreground="#303A4A"
                         HorizontalScrollBarVisibility="Disabled"
                         IsInactiveSelectionHighlightEnabled="True"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         SelectionBrush="#F6B56F"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource CuteReminderScrollBarStyle}" />
                    </TextBox.Resources>
                </TextBox>

                <Border x:Name="ReminderPagingPanel"
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="6,4"
                        HorizontalAlignment="Center"
                        Background="#FFFFF6EC"
                        BorderBrush="#F3C89F"
                        BorderThickness="1"
                        CornerRadius="19"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ReminderPreviousPageButton"
                                AutomationProperties.Name="上一页提醒"
                                Style="{StaticResource CuteReminderPageButtonStyle}"
                                ToolTip="上一页"
                                Click="PreviousPageButton_Click">
                            <Path Width="7"
                                  Height="12"
                                  Data="M7,1 L1,6 L7,11"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.8" />
                        </Button>

                        <Border Grid.Column="1"
                                MinWidth="92"
                                Margin="7,0"
                                Padding="12,0"
                                Background="#FFF0DE"
                                CornerRadius="14">
                            <TextBlock x:Name="ReminderPageText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#B96326"
                                       Text="第 1 / 1 页" />
                        </Border>

                        <Button x:Name="ReminderNextPageButton"
                                Grid.Column="2"
                                AutomationProperties.Name="下一页提醒"
                                Style="{StaticResource CuteReminderPageButtonStyle}"
                                ToolTip="下一页"
                                Click="NextPageButton_Click">
                            <Path Width="7"
                                  Height="12"
                                  Data="M1,1 L7,6 L1,11"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.8" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="2,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="10"
                               Foreground="#B58A67"
                               Text="内容可选中，按 Ctrl+C 复制" />

                    <Button x:Name="ReminderAcknowledgeButton"
                            Grid.Column="1"
                            MinWidth="92"
                            Height="34"
                            Padding="18,0"
                            AutomationProperties.Name="确认提醒"
                            Background="#F2A052"
                            BorderBrush="#D98435"
                            BorderThickness="1"
                            Content="知道啦"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Click="AcknowledgeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F2A052" />
                                <Setter Property="BorderBrush" Value="#D98435" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBackground"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBackground"
                                                            Property="Background"
                                                            Value="#ED9148" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBackground"
                                                            Property="Background"
                                                            Value="#DC7A32" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ButtonBackground"
                                                            Property="BorderBrush"
                                                            Value="#A9571C" />
                                                    <Setter TargetName="ButtonBackground"
                                                            Property="BorderThickness"
                                                            Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
