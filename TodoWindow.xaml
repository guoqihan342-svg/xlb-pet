                                    <UniformGrid Grid.Row="1" Columns="7">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="一" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="二" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="三" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="四" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#B69275" Text="五" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#C9826E" Text="六" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontSize="10.5" Foreground="#C9826E" Text="日" />
                                    </UniformGrid>
                                    <ItemsControl x:Name="ScheduledDateItemsControl"
                                                  Grid.Row="2"
                                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  SnapsToDevicePixels="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="6" Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="26"
                                                        Margin="1"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontFamily="Microsoft YaHei"
                                                        Tag="{Binding Date}"
                                                        ToolTip="{Binding AccessibleName}"
                                                        Click="ScheduledDateDayButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="ScheduledCalendarDayBorder"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <TextBlock x:Name="ScheduledCalendarDayText"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Microsoft YaHei"
                                                                           FontSize="11.5"
                                                                           Foreground="#75513A"
                                                                           Text="{Binding DayText}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="#BF715C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="#C8BDB2" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#F2A65A" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="Background"
                                                                            Value="#FFFFEBD2" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#F2C58F" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#D98238" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderThickness"
                                                                            Value="1.5" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="Background"
                                                                            Value="#F2A65A" />
                                                                    <Setter TargetName="ScheduledCalendarDayBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#E49345" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="Foreground"
                                                                            Value="White" />
                                                                    <Setter TargetName="ScheduledCalendarDayText"
                                                                            Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Grid.Row="3" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ScheduledDatePickerTodayButton"
                                                Grid.Column="0"
                                                MinWidth="48"
                                                Height="27"
                                                Padding="10,0"
                                                AutomationProperties.Name="选择今天"
                                                Background="#FFFFF0DD"
                                                BorderBrush="#E7B77D"
                                                BorderThickness="1"
                                                Content="今天"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                Foreground="#A45F30"
                                                ToolTip="选择今天并关闭"
                                                Click="ScheduledDatePickerTodayButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ScheduledDateTodayBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ScheduledDateTodayBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE4C3" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ScheduledDateTodayBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFD6A4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10.5"
                                                   Foreground="#B69275"
                                                   Text="点一下就选好啦" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                        <Border x:Name="ScheduledTimePickerHost"
                                Grid.Column="2"
                                Height="30"
                                BorderThickness="1"
                                CornerRadius="10"
                                Cursor="Hand"
                                SnapsToDevicePixels="True"
                                PreviewMouseLeftButtonDown="ScheduledTimeInput_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFF8EE" />
                                    <Setter Property="BorderBrush" Value="#E4C8AA" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ScheduledTimeInput}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=ScheduledTaskEditCancelButton}"
                                                     Value="Visible">
                                            <Setter Property="Background" Value="#FFFFEFD9" />
                                            <Setter Property="BorderBrush" Value="#F0A157" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="13"
                                         Height="13"
                                         Margin="5,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Width="13"
                                                 Height="13"
                                                 Canvas.Left="1.5"
                                                 Canvas.Top="1.5"
                                                 Fill="#FFFFE6C6"
                                                 Stroke="#C87534"
                                                 StrokeThickness="1.3" />
                                        <Path Data="M8,4.4 L8,8.1 L10.8,9.7"
                                              Stroke="#C87534"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.3" />
                                    </Canvas>
                                </Viewbox>
                                <TextBox x:Name="ScheduledTimeInput"
                                         Grid.Column="1"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="提醒时间，时分秒"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="Transparent"
                                         Cursor="Hand"
                                         FontFamily="Microsoft YaHei"
                                         FontSize="11.2"
                                         Foreground="#7A4B2C"
                                         InputMethod.IsInputMethodEnabled="False"
                                         IsReadOnly="True"
                                         MaxLength="8"
                                         TextAlignment="Center"
                                         ToolTip="点击选择时、分、秒"
                                         TextChanged="ScheduledTimeInput_TextChanged"
                                         PreviewKeyDown="ScheduledTimeInput_PreviewKeyDown" />
                                <Path Grid.Column="2"
                                      Width="7"
                                      Height="4"
                                      Margin="0,0,5,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L3.5,3.5 L7,0"
                                      IsHitTestVisible="False"
                                      Stroke="#B47A4E"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Grid>
                        </Border>
                        <Popup x:Name="ScheduledTimePickerPopup"
                               Grid.Column="2"
                               AllowsTransparency="True"
                               HorizontalOffset="-65"
                               Opened="ScheduledTimePickerPopup_Opened"
                               Closed="ScheduledTimePickerPopup_Closed"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ScheduledTimePickerHost}"
                               PopupAnimation="Fade"
                               StaysOpen="True"
                               VerticalOffset="5">
                            <Border Width="222"
                                    Padding="12,10,12,11"
                                    Background="#FFFFFCF7"
                                    BorderBrush="#EAB777"
                                    BorderThickness="1"
                                    CornerRadius="15"
                                    PreviewMouseDown="ScheduledTimePickerPopup_PreviewMouseDown"
                                    PreviewKeyDown="ScheduledTimePickerPopup_PreviewKeyDown"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      Direction="270"
                                                      Opacity="0.18"
                                                      ShadowDepth="3"
                                                      Color="#7A4B2C" />
                                </Border.Effect>
                                <Border.Resources>
                                    <Style x:Key="ScheduledTimePartComboBoxStyle"
                                           TargetType="{x:Type ComboBox}">
                                        <Setter Property="Width" Value="52" />
                                        <Setter Property="Height" Value="31" />
                                        <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="#70462D" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ComboBox}">
                                                    <Grid>
                                                        <ToggleButton Focusable="False"
                                                                      IsChecked="{Binding IsDropDownOpen,
                                                                                          RelativeSource={RelativeSource TemplatedParent},
                                                                                          Mode=TwoWay}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                    <Border x:Name="TimePartBorder"
                                                                            Background="#FFFFF3DF"
                                                                            BorderBrush="#E8BE89"
                                                                            BorderThickness="1"
                                                                            CornerRadius="9">
                                                                        <Grid>
                                                                            <ContentPresenter Margin="4,0,15,0"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Content="{Binding SelectionBoxItem,
                                                                                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                                            <Path Width="6"
                                                                                  Height="3"
                                                                                  Margin="0,0,6,0"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="M0,0 L3,3 L6,0"
                                                                                  Stroke="#B47A4E"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeThickness="1.1" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="TimePartBorder"
                                                                                    Property="Background"
                                                                                    Value="#FFFFE8C9" />
                                                                            <Setter TargetName="TimePartBorder"
                                                                                    Property="BorderBrush"
                                                                                    Value="#E29B51" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="TimePartBorder"
                                                                                    Property="Background"
                                                                                    Value="#FFFFE4BE" />
                                                                            <Setter TargetName="TimePartBorder"
                                                                                    Property="BorderBrush"
                                                                                    Value="#DC8D3F" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <Popup x:Name="PART_Popup"
                                                               AllowsTransparency="True"
                                                               Focusable="False"
                                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               Placement="Bottom"
                                                               PopupAnimation="Fade">
                                                            <Border MinWidth="{Binding ActualWidth,
                                                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                                                    MaxHeight="176"
                                                                    Margin="0,3,0,0"
                                                                    Padding="2"
                                                                    Background="#FFFFFCF7"
                                                                    BorderBrush="#EAB777"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9">
                                                                <ScrollViewer CanContentScroll="True"
                                                                              VerticalScrollBarVisibility="Auto">
                                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ItemContainerStyle">
                                            <Setter.Value>
                                                <Style TargetType="{x:Type ComboBoxItem}">
                                                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                                                 Handler="ScheduledTimePartItem_PreviewMouseLeftButtonDown" />
                                                    <Setter Property="Padding" Value="7,4" />
                                                    <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="Foreground" Value="#70462D" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                                <Border x:Name="TimeOptionBorder"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Background="Transparent"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="TimeOptionBorder"
                                                                                Property="Background"
                                                                                Value="#FFFFEBD2" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="TimeOptionBorder"
                                                                                Property="Background"
                                                                                Value="#FFFFDCA8" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Ellipse Width="13"
                                                         Height="13"
                                                         Canvas.Left="1.5"
                                                         Canvas.Top="1.5"
                                                         Fill="#FFFFE7C8"
                                                         Stroke="#C87534"
                                                         StrokeThickness="1.3" />
                                                <Path Data="M8,4.4 L8,8.1 L10.8,9.7"
                                                      Stroke="#C87534"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.3" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8B512C"
                                                   Text="选择提醒时间" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="时" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="分" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="秒" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ScheduledHourComboBox"
                                                  Grid.Column="0"
                                                  AutomationProperties.Name="提醒小时"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledMinuteComboBox"
                                                  Grid.Column="2"
                                                  AutomationProperties.Name="提醒分钟"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledSecondComboBox"
                                                  Grid.Column="4"
                                                  AutomationProperties.Name="提醒秒"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Height="28"
                                                Background="#FFFFF0DD"
                                                BorderBrush="#E7B77D"
                                                BorderThickness="1"
                                                Content="现在"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                Foreground="#A45F30"
                                                Click="ScheduledTimePickerNowButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="NowButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NowButtonBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE4C3" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Height="28"
                                                Background="#F2A65A"
                                                BorderThickness="0"
                                                Content="确定"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Click="ScheduledTimePickerConfirmButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ConfirmButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#F6B36F" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#DE8F42" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                        <Button x:Name="ScheduledTaskSubmitButton"
                                Grid.Column="4"
                                Height="30"
                                AutomationProperties.Name="新增或修改定时任务"
                                Content="新增"
                                Focusable="False"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                ToolTip="添加定时任务"
                                Click="ScheduledTaskAddButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CuteTaskButtonStyle}">
                                    <Setter Property="Background" Value="#F2A65A" />
                                    <Setter Property="BorderBrush" Value="#DB8B3E" />
                                    <Setter Property="Tag"
                                            Value="{StaticResource CuteOrangeHoverBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="Content" Value="确定修改">
                                            <Setter Property="Background" Value="#E88936" />
                                            <Setter Property="BorderBrush" Value="#C66F27" />
                                            <Setter Property="FontSize" Value="13.5" />
                                            <Setter Property="Tag"
                                                    Value="{StaticResource CuteOrangeEditHoverBrush}" />
                                        </Trigger>
                                        <!-- Keep the edit state orange until the
                                             code-side wording is upgraded. -->
                                        <Trigger Property="Content" Value="保存">
                                            <Setter Property="Background" Value="#E88936" />
                                            <Setter Property="BorderBrush" Value="#C66F27" />
                                            <Setter Property="Tag"
                                                    Value="{StaticResource CuteOrangeEditHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScheduledTaskValidationText"
                                   Grid.Column="0"
                                   Height="18"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#C65353"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ScheduledRepeatRulePreviewText"
                                   Grid.Column="0"
                                   Height="18"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#A26D43"
                                   IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <Button x:Name="ScheduledTaskEditCancelButton"
                                Grid.Column="1"
                                MinWidth="31"
                                MinHeight="0"
                                Height="18"
                                Margin="4,0,0,0"
                                Padding="2,0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="取消修改定时任务"
                                Background="#FFFFF4E5"
                                BorderBrush="#E7B77D"
                                BorderThickness="1"
                                Content="取消"
                                FontSize="10.5"
                                Foreground="#B47A4E"
                                Style="{StaticResource CuteTaskButtonStyle}"
                                Tag="{StaticResource CuteCreamHoverBrush}"
                                ToolTip="取消修改"
                                Visibility="Collapsed"
                                Click="ScheduledTaskEditCancelButton_Click" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="EdgeRoamingToggle"
                              Grid.Column="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="绕屏动画"
                              Content="绕屏动画"
                              Cursor="Hand"
                              FontFamily="Microsoft YaHei"
                              FontSize="12"
                              Foreground="#515966"
                              Style="{StaticResource CuteSettingsSwitchStyle}"
                              IsChecked="True"
                              ToolTip="控制小鲁班是否自动绕着屏幕移动"
                              Checked="EdgeRoamingToggle_Changed"
                              Unchecked="EdgeRoamingToggle_Changed" />
                    <CheckBox x:Name="StartupToggle"
                              Grid.Column="1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="开机自启"
                              Content="开机自启"
                              Cursor="Hand"
                              FontFamily="Microsoft YaHei"
                              FontSize="12"
                              Foreground="#515966"
                              Style="{StaticResource CuteSettingsSwitchStyle}"
                              IsChecked="False"
                              ToolTip="登录 Windows 后自动启动小鲁班"
                              Checked="StartupToggle_Changed"
                              Unchecked="StartupToggle_Changed" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               Foreground="#515966"
                               Text="桌宠大小" />
                    <Slider x:Name="PetSizeSlider"
                            Grid.Column="1"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei"
                            Style="{StaticResource CutePetSizeSliderStyle}"
                            Minimum="75"
                            Maximum="140"
                            SnapsToDevicePixels="False"
                            TickFrequency="1"
                            UseLayoutRounding="False"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            SmallChange="1"
                            LargeChange="5"
                            ToolTip="默认 100% 比旧版高度增加约 1.5 厘米"
                            ValueChanged="PetSizeSlider_ValueChanged" />
                    <TextBlock x:Name="PetSizeLabel"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               Foreground="#515966"
                               TextAlignment="Right"
                               Text="100%" />
                </Grid>

            </Grid>
        </Border>

        <Grid x:Name="TailHost"
              Grid.Column="1"
              Margin="-1,198,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
            <Polygon x:Name="TailPolygon"
                     Points="0,0 12,9 0,18"
                     Fill="White"
                     Stroke="#D8DEE8"
                     StrokeThickness="1" />
        </Grid>

        <Popup x:Name="TaskFullTextPopup"
               AllowsTransparency="True"
               Placement="Custom"
               PopupAnimation="Fade"
               StaysOpen="True"
               Opened="TaskFullTextPopup_Opened"
               Closed="TaskFullTextPopup_Closed">
            <Border x:Name="TaskFullTextPopupChrome"
                    Width="320"
                    MaxHeight="228"
                    Padding="11,9,11,10"
                    Background="#FFFFF8F1"
                    BorderBrush="#EF9465"
                    BorderThickness="1.2"
                    CornerRadius="13"
                    MouseEnter="TaskFullTextPopup_MouseEnter"
                    MouseLeave="TaskFullTextPopup_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      Opacity="0.2"
                                      ShadowDepth="3"
                                      Color="#A85536" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TaskFullTextTitle"
                               FontFamily="Microsoft YaHei"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#C45F3D"
                               Text="完整内容 · 可选择复制" />
                    <TextBox x:Name="TaskFullTextPreviewTextBox"
                             Grid.Row="1"
                             MinHeight="40"
                             MaxHeight="170"
                             Padding="7,5"
                             Background="#FFFFFCF8"
                             BorderBrush="#F1C19E"
                             BorderThickness="1"
                             Cursor="IBeam"
                             FontFamily="Microsoft YaHei"
                             FontSize="12.5"
                             Foreground="#4B342B"
                             IsInactiveSelectionHighlightEnabled="True"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             SelectionBrush="#F5B07D"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource TaskListScrollBarStyle}" />
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock x:Name="TaskFullTextCountText"
                               Grid.Row="2"
                               Margin="1,2,1,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontFamily="Microsoft YaHei"
                               FontSize="10"
                               Foreground="#C18A6C" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
