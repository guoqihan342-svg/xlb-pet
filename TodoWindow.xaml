                                     FontFamily="Microsoft YaHei"
                                     FontSize="11"
                                     MaxLength="7"
                                     Text="1"
                                     TextAlignment="Center"
                                     TextChanged="ScheduledRepeatInput_TextChanged"
                                     PreviewTextInput="ScheduledRepeatInput_PreviewTextInput">
                                <TextBox.Style>
                                    <Style TargetType="{x:Type TextBox}">
                                        <Setter Property="Background" Value="#FFFFFCF7" />
                                        <Setter Property="BorderBrush" Value="#E4C8AA" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="SelectionBrush" Value="#FFD7A6" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Background" Value="#FFFFF8EE" />
                                                <Setter Property="BorderBrush" Value="#E89D52" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=ScheduledTaskEditCancelButton}"
                                                         Value="Visible">
                                                <Setter Property="Background" Value="#FFFFF4E5" />
                                                <Setter Property="BorderBrush" Value="#F0A157" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <ComboBox x:Name="ScheduledRepeatUnitComboBox"
                                      Width="62"
                                      Height="25"
                                      Margin="4,0,0,0"
                                      Padding="5,1"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="循环间隔单位"
                                      Background="#FFFFF8EE"
                                      BorderBrush="#E4C8AA"
                                      FontFamily="Microsoft YaHei"
                                      FontSize="11"
                                      Foreground="#725B49"
                                       SelectionChanged="ScheduledRepeatUnitComboBox_SelectionChanged"
                                       DropDownOpened="ScheduledRepeatUnitComboBox_DropDownOpened"
                                       DropDownClosed="ScheduledRepeatUnitComboBox_DropDownClosed"
                                       PreviewKeyDown="ScheduledRepeatUnitComboBox_PreviewKeyDown">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="{x:Type ComboBox}">
                                        <Grid>
                                            <Border x:Name="RepeatUnitButtonBorder"
                                                    Background="#FFFFF3DF"
                                                    BorderBrush="#E8BE89"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <Grid>
                                                    <ContentPresenter Margin="5,1,17,1"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{Binding SelectionBoxItem,
                                                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                      IsHitTestVisible="False"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    <Path Width="6"
                                                          Height="3"
                                                          Margin="0,0,6,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Data="M0,0 L3,3 L6,0"
                                                          IsHitTestVisible="False"
                                                          Stroke="#B47A4E"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.1" />
                                                    <ToggleButton Background="Transparent"
                                                                  BorderThickness="0"
                                                                  ClickMode="Press"
                                                                  Focusable="False"
                                                                  IsChecked="{Binding IsDropDownOpen,
                                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                                      Mode=TwoWay}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                <Border Background="Transparent" />
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>
                                            </Border>

                                            <Popup x:Name="PART_Popup"
