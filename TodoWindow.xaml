                               Closed="ScheduledDatePickerPopup_Closed"
                               HorizontalOffset="0"
                               Opened="ScheduledDatePickerPopup_Opened"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ScheduledDatePickerHost}"
