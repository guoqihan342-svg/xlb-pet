<Window x:Class="LubanDesktopPet.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班待办事项"
        Width="292"
        Height="306"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FirstColumn" Width="280" />
            <ColumnDefinition x:Name="SecondColumn" Width="12" />
        </Grid.ColumnDefinitions>

        <Border x:Name="TodoBorder"
                Grid.Column="0"
                Padding="14"
                Background="White"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#202631"
                               Text="待办事项" />
                    <Button Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            Background="#F1F3F6"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei UI"
                            Foreground="#515966"
                            Content="收起"
                            Click="CloseButton_Click" />
                    <Button Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            Background="#FFF0F0"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei UI"
                            Foreground="#C04444"
                            Content="退出"
                            Click="ExitButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,8">
                    <ListBox x:Name="TodoItemsControl"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3"
                                            Padding="7,2"
                                            Background="#F6F7F9"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Margin="0,0,7,0"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="TodoCheckBox_Click" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Microsoft YaHei UI"
                                                       FontSize="13"
                                                       Text="{Binding Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#303744" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="#9097A3" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="2"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="16"
                                                    Foreground="#A0A6B0"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    Click="DeleteButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13"
                               Foreground="#9AA1AC"
                               IsHitTestVisible="False"
                               Text="还没有待办，写下一件事吧">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=TodoItemsControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox x:Name="AutoRoamToggle"
                          Grid.Row="2"
                          VerticalAlignment="Center"
                          Cursor="Hand"
                          FontFamily="Microsoft YaHei UI"
                          FontSize="12"
                          Foreground="#515966"
                          Content="自动绕屏移动"
                          ToolTip="仅控制沿屏幕边缘移动，其他自动可爱动作不受影响"
                          Checked="AutoRoamToggle_Changed"
                          Unchecked="AutoRoamToggle_Changed" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TodoInput"
                             Grid.Column="0"
                             Margin="0,0,7,0"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D8DEE8"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="13"
                             InputMethod.IsInputMethodEnabled="True"
                             MaxLength="80"
                             ToolTip="输入待办事项，按回车添加"
                             PreviewKeyDown="TodoInput_PreviewKeyDown" />
                    <Button Grid.Column="1"
                            Background="#5B8DEF"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei UI"
                            Foreground="White"
                            Content="新增"
                            Click="AddButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="TailHost"
              Grid.Column="1"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Polygon x:Name="TailPolygon"
                     Points="0,0 12,9 0,18"
                     Fill="White"
                     Stroke="#D8DEE8"
                     StrokeThickness="1" />
        </Grid>
    </Grid>
</Window>
