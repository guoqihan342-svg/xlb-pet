                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="7">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFEBD2" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFDCA8" />
                                                            <Setter Property="Foreground"
                                                                    Value="#8A4F21" />
                                                            <Setter Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE5C2" />
                                                            <Setter TargetName="RepeatUnitOptionBorder"
                                                                    Property="BorderBrush"
                                                                    Value="#D98A45" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="#ADA39A" />
                                                            <Setter Property="Opacity"
                                                                    Value="0.7" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="11"
                                       Foreground="#725B49"
                                       Text="提醒" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScheduledRepeatHintText"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="11"
                                   Foreground="#A26D43"
                                   Text="保存后按间隔首次提醒"
                                   Visibility="Collapsed" />
                        <Border x:Name="ScheduledDatePickerHost"
                                Grid.Column="0"
                                Height="30"
                                BorderThickness="1"
                                CornerRadius="10"
                                Cursor="Hand"
                                SnapsToDevicePixels="True"
                                PreviewMouseLeftButtonDown="ScheduledDateInput_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFF8EE" />
                                    <Setter Property="BorderBrush" Value="#E4C8AA" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFF1DF" />
                                            <Setter Property="BorderBrush" Value="#E7AD70" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ScheduledDateInput}"
                                                     Value="True">
                                            <Setter Property="Background" Value="#FFFFF4E5" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=ScheduledDatePickerPopup}"
                                                     Value="True">
