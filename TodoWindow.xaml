                                                     Value="Visible">
                                            <Setter Property="Background" Value="#FFFFEFD9" />
                                            <Setter Property="BorderBrush" Value="#F0A157" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         Width="13"
                                         Height="13"
                                         Margin="5,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False">
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Width="12.5"
                                                   Height="11.5"
                                                   Canvas.Left="1.75"
                                                   Canvas.Top="2.75"
                                                   RadiusX="2.3"
                                                   RadiusY="2.3"
                                                   Fill="#FFFFE6C6"
                                                   Stroke="#C87534"
                                                   StrokeThickness="1.2" />
                                        <Path Data="M2.2,6.1 L13.8,6.1 M5,1.6 L5,4.2 M11,1.6 L11,4.2"
                                              Stroke="#C87534"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.2" />
