                                        <Ellipse Width="1.5"
                                                 Height="1.5"
                                                 Canvas.Left="7.25"
                                                 Canvas.Top="8.1"
                                                 Fill="#D98A45" />
                                        <Ellipse Width="1.5"
                                                 Height="1.5"
                                                 Canvas.Left="10.4"
                                                 Canvas.Top="8.1"
