                                  Checked="ScheduledRepeatToggle_Changed"
                                  Unchecked="ScheduledRepeatToggle_Changed" />
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding IsChecked, ElementName=ScheduledRepeatToggle}"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="11"
                                       Foreground="#725B49"
                                       Text="每" />
