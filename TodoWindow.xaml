                                    Padding="10"
                                    Background="#FFFFFCF7"
                                    BorderBrush="#EAB777"
                                    BorderThickness="1"
                                    CornerRadius="15"
                                    PreviewKeyDown="ScheduledDatePickerPopup_PreviewKeyDown"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                                      Direction="270"
                                                      Opacity="0.18"
                                                      ShadowDepth="3"
                                                      Color="#7A4B2C" />
                                </Border.Effect>
                                <Border.Resources>
                                    <Style x:Key="ScheduledCalendarNavButtonStyle"
