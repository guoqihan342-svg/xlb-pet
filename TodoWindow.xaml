<Window x:Class="LubanDesktopPet.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鲁班任务小屋"
        Width="292"
        Height="414"
        MinHeight="414"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy"
                        PreviewCanExecute="CopyCommand_CanExecute"
                        PreviewExecuted="CopyCommand_Executed" />
    </Window.CommandBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="CuteCreamHoverBrush" Color="#FFFFE9CC" />
        <SolidColorBrush x:Key="CuteCollapseHoverBrush" Color="#FFFFE4C2" />
        <SolidColorBrush x:Key="CuteDangerHoverBrush" Color="#FFFFD9D9" />
        <SolidColorBrush x:Key="CuteBlueHoverBrush" Color="#3477E8" />
        <SolidColorBrush x:Key="CuteOrangeHoverBrush" Color="#F8B971" />
        <SolidColorBrush x:Key="CuteOrangeEditHoverBrush" Color="#F2A65A" />
        <!--
            The task house uses a single, lightweight button chrome.  The
            per-button Background/BorderBrush/Foreground keep each action's
            meaning clear, while Tag supplies its hover tint without creating
            several almost-identical control templates.
        -->
        <Style x:Key="CuteTaskButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="#FFFFF7EA" />
            <Setter Property="BorderBrush" Value="#E8C99F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#865A35" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Tag"
                    Value="{StaticResource CuteCreamHoverBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="ButtonRoot"
                              Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="HoverTint"
                                    Background="{TemplateBinding Tag}"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Ellipse Width="13"
                                     Height="5"
                                     Margin="5,3,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Fill="#70FFFFFF"
                                     IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <Border x:Name="KeyboardFocusRing"
                                    Margin="-2"
                                    BorderBrush="#E89B50"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Border x:Name="PressedShade"
                                    Background="#18000000"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverTint"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot"
                                        Property="Opacity"
                                        Value="0.96" />
                                <Setter TargetName="PressedShade"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot"
                                        Property="Opacity"
                                        Value="0.43" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskRowIconButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Foreground" Value="#8295B3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#3E70C6" />
                                <Setter TargetName="IconButtonChrome"
                                        Property="Background"
                                        Value="#E5F0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonChrome"
                                        Property="Background"
                                        Value="#D5E6FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduledTaskRowIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TaskRowIconButtonStyle}">
            <Setter Property="Foreground" Value="#B69275" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ScheduledIconButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C66E2B" />
                                <Setter TargetName="ScheduledIconButtonChrome"
                                        Property="Background"
                                        Value="#FFFFE7CC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ScheduledIconButtonChrome"
                                        Property="Background"
                                        Value="#FFFFD8AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskListPageButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskListThumbStyle"
               TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="#E7A15E" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Border x:Name="ThumbPill"
                                    Width="7"
                                    Margin="0,1"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3.5"
                                    SnapsToDevicePixels="True">
                                <Border x:Name="ThumbHighlight"
                                        Width="2"
                                        Margin="1.5,4,0,4"
                                        HorizontalAlignment="Left"
                                        Background="#70FFFFFF"
                                        CornerRadius="1"
                                        Opacity="0.7" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{Binding Tag,
                                                        RelativeSource={RelativeSource Self}}" />
                                <Setter TargetName="ThumbHighlight"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background"
                                        Value="{Binding BorderBrush,
                                                        RelativeSource={RelativeSource Self}}" />
                                <Setter TargetName="ThumbPill"
                                        Property="Width"
                                        Value="8" />
                                <Setter TargetName="ThumbHighlight"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbPill"
                                        Property="Opacity"
                                        Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskListScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Margin" Value="2,1,0,1" />
            <Setter Property="Background" Value="#22D6A06A" />
            <Setter Property="BorderBrush" Value="#D97B2F" />
            <Setter Property="Foreground" Value="#E7A15E" />
            <Setter Property="Tag" Value="#F09A48" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <Border x:Name="TrackPill"
                                    Width="8"
                                    Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Opacity="0.72" />
                            <Track x:Name="PART_Track"
                                   Margin="1,3"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource TaskListPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{TemplateBinding Foreground}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           Style="{StaticResource TaskListThumbStyle}"
                                           Tag="{TemplateBinding Tag}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource TaskListPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackPill"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackPill"
                                        Property="Opacity"
                                        Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CuteTaskCheckBoxStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Foreground" Value="#73523A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CuteCheckShell"
                                    Width="19"
                                    Height="19"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#FFFFF7EA"
                                    BorderBrush="#E8BE89"
                                    BorderThickness="1.2"
                                    CornerRadius="7">
                                <Grid>
                                    <Ellipse Width="8"
                                             Height="3"
                                             Margin="3,2,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#8FFFFFFF"
                                             IsHitTestVisible="False" />
                                    <Path x:Name="CuteCheckMark"
                                          Width="11"
                                          Height="8"
                                          Data="M1,4 L4.2,7 L10,1"
                                          Fill="Transparent"
                                          Stroke="White"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CuteCheckShell"
                                        Property="Background"
                                        Value="#FFFFEACF" />
                                <Setter TargetName="CuteCheckShell"
                                        Property="BorderBrush"
                                        Value="#E49649" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CuteCheckShell"
                                        Property="Background"
                                        Value="#F2A052" />
                                <Setter TargetName="CuteCheckShell"
                                        Property="BorderBrush"
                                        Value="#D98435" />
                                <Setter TargetName="CuteCheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CuteCheckShell"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CuteSettingsSwitchStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#675344" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="41" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="36"
                                    Height="21"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#FFF3E3D2"
                                    BorderBrush="#E2B988"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Grid Margin="2">
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="15"
                                             Height="15"
                                             HorizontalAlignment="Left"
                                             Fill="#FFFFFCF7"
                                             Stroke="#E2B27E"
                                             StrokeThickness="1">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="3"
                                                              Direction="270"
                                                              Opacity="0.18"
                                                              ShadowDepth="1"
                                                              Color="#8A5D38" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Grid x:Name="KnobFace"
                                          Width="11"
                                          Height="9"
                                          HorizontalAlignment="Left"
                                          Margin="2,3,0,0"
                                          IsHitTestVisible="False">
                                        <Ellipse Width="1.6"
                                                 Height="1.9"
                                                 Margin="2,2,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Fill="#B67845" />
                                        <Ellipse Width="1.6"
                                                 Height="1.9"
                                                 Margin="0,2,2,0"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Fill="#B67845" />
                                        <Path Width="4"
                                              Height="2"
                                              Margin="0,0,0,1"
                                              VerticalAlignment="Bottom"
                                              Data="M0,0 C1,2 3,2 4,0"
                                              Fill="Transparent"
                                              Stroke="#B67845"
                                              StrokeEndLineCap="Round"
                                              StrokeThickness="0.8" />
                                    </Grid>
                                    <Ellipse Width="8"
                                             Height="3"
                                             Margin="4,1,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="#80FFFFFF"
                                             IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="#FFFFE7C9" />
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="#E49A50" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="#F7B46E" />
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="#DB873B" />
                                <Setter TargetName="SwitchKnob"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="KnobFace"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="KnobFace"
                                        Property="Margin"
                                        Value="0,3,2,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CutePetSizeSliderStyle"
               TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Margin="7,0"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="7"
                                                        Background="#F5AD68"
                                                        CornerRadius="4,0,0,4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="CuteSizeThumb"
                                           Width="24"
                                           Height="24"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse x:Name="ThumbShadow"
                                                             Margin="1,2,1,0"
                                                             Fill="#45A85E25" />
                                                    <Ellipse x:Name="ThumbFace"
                                                             Margin="1,0,1,2"
                                                             Fill="#FFFFE7C5"
                                                             Stroke="#E28E43"
                                                             StrokeThickness="1.2" />
                                                    <Ellipse Width="8"
                                                             Height="3"
                                                             Margin="5,3,0,0"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Top"
                                                             Fill="#90FFFFFF" />
                                                    <Ellipse Width="2.2"
                                                             Height="2.5"
                                                             Margin="7,0,0,7"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Bottom"
                                                             Fill="#A76435" />
                                                    <Ellipse Width="2.2"
                                                             Height="2.5"
                                                             Margin="0,0,7,7"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Fill="#A76435" />
                                                    <Path Width="6"
                                                          Height="3"
                                                          Margin="0,0,0,4"
                                                          VerticalAlignment="Bottom"
                                                          Data="M0,0 C1.5,3 4.5,3 6,0"
                                                          Fill="Transparent"
                                                          Stroke="#A76435"
                                                          StrokeEndLineCap="Round"
                                                          StrokeThickness="1" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbFace"
                                                                Property="Fill"
                                                                Value="#FFFFD9A7" />
                                                        <Setter TargetName="ThumbFace"
                                                                Property="Stroke"
                                                                Value="#D8792C" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbFace"
                                                                Property="Fill"
                                                                Value="#FFC98A" />
                                                        <Setter TargetName="ThumbShadow"
                                                                Property="Opacity"
                                                                Value="0.72" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="7"
                                                        Background="#FFF0DDC8"
                                                        BorderBrush="#E8C39A"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="0,4,4,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FirstColumn" Width="280" />
            <ColumnDefinition x:Name="SecondColumn" Width="12" />
        </Grid.ColumnDefinitions>

        <Border x:Name="TodoBorder"
                Grid.Column="0"
                Padding="14"
                Background="White"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TodoTabButton"
                                 Grid.Column="0"
                                 MinWidth="66"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="待办事项选项卡"
                                 Content="待办事项"
                                 Cursor="Hand"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="#687181"
                                 GroupName="TaskTabs"
                                 IsChecked="True"
                                 Click="TodoTabButton_Click">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="TabBorder"
                                        Padding="9,5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{TemplateBinding Content}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#F3F7FD" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="#3E70C6" />
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#EAF3FF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="BorderBrush"
                                                Value="#8CB4F4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton x:Name="ScheduledTaskTabButton"
                                 Grid.Column="1"
                                 MinWidth="66"
                                 Height="30"
                                 Margin="2,0,0,0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="定时任务选项卡"
                                 Content="定时任务"
                                 Cursor="Hand"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="#687181"
                                 GroupName="TaskTabs"
                                 Click="ScheduledTaskTabButton_Click">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="TabBorder"
                                        Padding="9,5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Microsoft YaHei"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{TemplateBinding Content}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#FFF5EB" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="#C87534" />
                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#FFF0DF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabBorder"
                                                Property="BorderBrush"
                                                Value="#EDB77C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <Button x:Name="CollapseButton"
                            Grid.Column="3"
                            Width="38"
                            Height="28"
                            Margin="3,0,0,0"
                            Padding="4,3"
                            AutomationProperties.Name="收起任务小屋"
                            FontSize="11"
                            ToolTip="收起任务小屋"
                            Content="收起"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource CuteTaskButtonStyle}">
                                <Setter Property="Background" Value="#EDF5FF" />
                                <Setter Property="BorderBrush" Value="#B8D2F5" />
                                <Setter Property="Foreground" Value="#3E70C6" />
                                <Setter Property="Tag" Value="#CFE2FB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked,
                                                                   ElementName=ScheduledTaskTabButton}"
                                                 Value="True">
                                        <Setter Property="Background" Value="#FFF6E9" />
                                        <Setter Property="BorderBrush" Value="#E7C99E" />
                                        <Setter Property="Foreground" Value="#A46634" />
                                        <Setter Property="Tag"
                                                Value="{StaticResource CuteCollapseHoverBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4"
                            Width="38"
                            Height="28"
                            Margin="3,0,0,0"
                            Padding="4,3"
                            AutomationProperties.Name="退出小鲁班桌宠"
                            Background="#FFFFEEEE"
                            BorderBrush="#F0BBBB"
                            FontSize="11"
                            Foreground="#C04444"
                            Style="{StaticResource CuteTaskButtonStyle}"
                            Tag="{StaticResource CuteDangerHoverBrush}"
                            ToolTip="退出小鲁班桌宠"
                            Content="退出"
                            Click="ExitButton_Click" />
                </Grid>

                <Grid x:Name="TodoPage"
                      Grid.Row="1"
                      Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <ListBox x:Name="TodoItemsControl"
                             AllowDrop="True"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.PanningMode="VerticalOnly"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewDragOver="TodoItemsControl_PreviewDragOver"
                             PreviewDrop="TodoItemsControl_PreviewDrop">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource TaskListScrollBarStyle}">
                                <Setter Property="Background" Value="#245B8DEF" />
                                <Setter Property="BorderBrush" Value="#3E70C6" />
                                <Setter Property="Foreground" Value="#7BA6E8" />
                                <Setter Property="Tag" Value="#5B8DEF" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                 <Setter Property="Padding" Value="0" />
                                 <Setter Property="Margin" Value="0" />
                                 <Setter Property="BorderBrush" Value="Transparent" />
                                 <Setter Property="BorderThickness" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TodoRowBorder"
                                            Margin="0,0,0,2"
                                            Padding="7,4"
                                            MaxHeight="54"
                                            CornerRadius="9"
                                            Tag="{Binding}"
                                            MouseEnter="TaskRow_MouseEnter"
                                            MouseLeave="TaskRow_MouseLeave"
                                            Unloaded="TaskRow_Unloaded">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F7FD" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAF3FF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="TodoDragHandle"
                                                    Grid.Column="0"
                                                    Width="18"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Stretch"
                                                    Background="Transparent"
                                                    Cursor="SizeAll"
                                                     Tag="{Binding}"
                                                     ToolTip="拖动调整顺序"
                                                     LostMouseCapture="TodoDragHandle_LostMouseCapture"
                                                     PreviewMouseLeftButtonDown="TodoDragHandle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="TodoDragHandle_PreviewMouseLeftButtonUp"
                                                    PreviewMouseMove="TodoDragHandle_PreviewMouseMove">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Microsoft YaHei"
                                                           FontSize="15"
                                                           Foreground="#9AA1AC"
                                                           IsHitTestVisible="False"
                                                           Text="≡" />
                                            </Border>
                                            <CheckBox Grid.Column="1"
                                                      Margin="0,0,7,0"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand"
                                                      Style="{StaticResource CuteTaskCheckBoxStyle}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="TodoCheckBox_Click" />
                                            <TextBox x:Name="TodoTextBox"
                                                     Grid.Column="2"
                                                     MinWidth="0"
                                                     MaxHeight="36"
                                                     ClipToBounds="True"
                                                     VerticalAlignment="Center"
                                                     Cursor="IBeam"
                                                     FontFamily="Microsoft YaHei"
                                                     FontSize="13"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     MaxLength="5000"
                                                     MaxLines="2"
                                                     MinLines="1"
                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                     TextWrapping="Wrap"
                                                     DataContextChanged="TodoEditTextBox_DataContextChanged"
                                                     LostKeyboardFocus="TodoEditTextBox_LostKeyboardFocus"
                                                     LostMouseCapture="TaskRowTextBox_LostMouseCapture"
                                                     PreviewMouseLeftButtonDown="TaskRowTextBox_PreviewMouseLeftButtonDown"
                                                     PreviewMouseLeftButtonUp="TaskRowTextBox_PreviewMouseLeftButtonUp"
                                                     PreviewMouseMove="TaskRowTextBox_PreviewMouseMove"
                                                     SelectionChanged="TaskRowTextBox_SelectionChanged"
                                                     TextChanged="TodoEditTextBox_TextChanged"
                                                     Unloaded="TodoEditTextBox_Unloaded"
                                                     PreviewKeyDown="TodoEditTextBox_PreviewKeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="#303744" />
                                                        <Setter Property="IsReadOnly" Value="True" />
                                                        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                                                        <Setter Property="IsTabStop" Value="False" />
                                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsReadOnly" Value="False">
                                                                <Setter Property="Padding" Value="4,1" />
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#5B8DEF" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="IsReadOnlyCaretVisible" Value="True" />
                                                                <Setter Property="IsTabStop" Value="True" />
                                                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="#9097A3" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button x:Name="TodoEditButton"
                                                    Grid.Column="3"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Style="{StaticResource TaskRowIconButtonStyle}"
                                                    AutomationProperties.Name="修改待办"
                                                    ToolTip="修改待办"
                                                    Tag="{Binding}"
                                                    Click="EditButton_Click">
                                                <Viewbox Width="14"
                                                         Height="14"
                                                         IsHitTestVisible="False">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Data="M13.2,1.5 L14.5,2.8 L5,12.3 L1.7,14.3 L3.7,11 Z"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.4" />
                                                        <Path Data="M3.7,11 L5,12.3"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeThickness="1.4" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    FontSize="16"
                                                    Style="{StaticResource TaskRowIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="DeleteButton_Click">
                                                <Viewbox Width="10"
                                                         Height="10"
                                                         IsHitTestVisible="False">
                                                    <Canvas Width="10" Height="10">
                                                        <Path Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="13"
                               Foreground="#9AA1AC"
                               IsHitTestVisible="False"
                               Text="还没有待办，写下一件事吧">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=TodoItemsControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TodoInput"
                                 Grid.Column="0"
                                 Margin="0,0,7,0"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="13"
                                 InputMethod.IsInputMethodEnabled="True"
                                 MaxLength="5000"
                                 ToolTip="输入待办事项，按回车添加"
                                 PreviewKeyDown="TodoInput_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Background" Value="#F8FBFF" />
                                    <Setter Property="BorderBrush" Value="#BDD2EF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="SelectionBrush" Value="#A9C9F4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="#F2F7FF" />
                                            <Setter Property="BorderBrush" Value="#5B8DEF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1"
                                AutomationProperties.Name="新增待办事项"
                                Background="#5B8DEF"
                                BorderBrush="#4F7FD7"
                                Focusable="False"
                                Foreground="White"
                                Style="{StaticResource CuteTaskButtonStyle}"
                                Tag="{StaticResource CuteBlueHoverBrush}"
                                ToolTip="新增待办事项"
                                Content="新增"
                                Click="AddButton_Click" />
                    </Grid>
                </Grid>

                <Grid x:Name="ScheduledTaskPage"
                      Grid.Row="1"
                      Margin="0,8,0,0"
                      Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1"
                            Grid.RowSpan="4"
                            Margin="-4,-3,-4,-3"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Panel.ZIndex="-1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=ScheduledTaskEditCancelButton}"
                                                 Value="Visible">
                                        <Setter Property="Background" Value="#20F2A65A" />
                                        <Setter Property="BorderBrush" Value="#F0A157" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Grid.Row="0">
                        <ListBox x:Name="ScheduledTaskItemsControl"
                                 MinHeight="168"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource TaskListScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ScheduledTaskRowBorder"
                                            Margin="0,0,0,2"
                                            Padding="7,4"
                                            MaxHeight="54"
                                            CornerRadius="9"
                                            Tag="{Binding}"
                                            MouseEnter="TaskRow_MouseEnter"
                                            MouseLeave="TaskRow_MouseLeave"
                                            Unloaded="TaskRow_Unloaded">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF8EF" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFE8D0" />
                                                        <Setter Property="BorderBrush" Value="#F0A45F" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                 <TextBlock Grid.Row="0"
                                                            FontFamily="Microsoft YaHei"
                                                            FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C87534"
                                                           Text="{Binding DueAtDisplayText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DueAtDisplayText}" />
                                                <TextBox Grid.Row="1"
                                                         MinWidth="0"
                                                         Padding="0"
                                                         ClipToBounds="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                          Cursor="IBeam"
                                                         FontFamily="Microsoft YaHei"
                                                         FontSize="13"
                                                         Foreground="#303744"
                                                         SelectionBrush="#FFD7A6"
                                                         IsReadOnly="True"
                                                         IsReadOnlyCaretVisible="False"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         MaxHeight="30"
                                                         MaxLength="5000"
                                                         MaxLines="2"
                                                         Text="{Binding Text}"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Disabled"
                                                         LostMouseCapture="TaskRowTextBox_LostMouseCapture"
                                                         PreviewMouseLeftButtonDown="TaskRowTextBox_PreviewMouseLeftButtonDown"
                                                         PreviewMouseLeftButtonUp="TaskRowTextBox_PreviewMouseLeftButtonUp"
                                                         PreviewMouseMove="TaskRowTextBox_PreviewMouseMove"
                                                         SelectionChanged="TaskRowTextBox_SelectionChanged"
                                                         Unloaded="TaskRowTextBox_Unloaded" />
                                            </Grid>
                                            <Button x:Name="ScheduledTaskEditButton"
                                                    Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="修改定时任务"
                                                    Style="{StaticResource ScheduledTaskRowIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="修改定时任务"
                                                    Click="ScheduledTaskEditButton_Click">
                                                <Viewbox Width="14"
                                                         Height="14"
                                                         IsHitTestVisible="False">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Data="M13.2,1.5 L14.5,2.8 L5,12.3 L1.7,14.3 L3.7,11 Z"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.4" />
                                                        <Path Data="M3.7,11 L5,12.3"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeThickness="1.4" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="删除定时任务"
                                                    FontSize="16"
                                                    Style="{StaticResource ScheduledTaskRowIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="删除定时任务"
                                                    Click="ScheduledTaskDeleteButton_Click">
                                                <Viewbox Width="10"
                                                         Height="10"
                                                         IsHitTestVisible="False">
                                                    <Canvas Width="10" Height="10">
                                                        <Path Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="12"
                                   Foreground="#A69B91"
                                   IsHitTestVisible="False"
                                   Text="还没有定时任务，设一个可爱提醒吧">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ScheduledTaskItemsControl}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="ScheduledTaskInput"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Microsoft YaHei"
                                 FontSize="13"
                                 InputMethod.IsInputMethodEnabled="True"
                                 MaxLength="5000"
                                 ToolTip="输入提醒内容，按回车设定"
                                 TextChanged="ScheduledTaskInput_TextChanged"
