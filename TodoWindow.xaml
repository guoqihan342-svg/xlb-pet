                                            <Setter Property="BorderBrush" Value="#F0AE6D" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="#FFFFF8EE" />
                                            <Setter Property="BorderBrush" Value="#E89D52" />
                                            <Setter Property="BorderThickness" Value="1.5" />
