                                                                 Handler="ScheduledTimePartItem_PreviewMouseLeftButtonDown" />
                                                    <Setter Property="Padding" Value="7,4" />
                                                    <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="Foreground" Value="#70462D" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                                <Border x:Name="TimeOptionBorder"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Background="Transparent"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="TimeOptionBorder"
                                                                                Property="Background"
                                                                                Value="#FFFFEBD2" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="TimeOptionBorder"
                                                                                Property="Background"
                                                                                Value="#FFFFDCA8" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Ellipse Width="13"
                                                         Height="13"
                                                         Canvas.Left="1.5"
                                                         Canvas.Top="1.5"
                                                         Fill="#FFFFE7C8"
                                                         Stroke="#C87534"
                                                         StrokeThickness="1.3" />
                                                <Path Data="M8,4.4 L8,8.1 L10.8,9.7"
                                                      Stroke="#C87534"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.3" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8B512C"
                                                   Text="选择提醒时间" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="时" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="分" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="10"
                                                   Foreground="#B69275"
                                                   Text="秒" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ScheduledHourComboBox"
                                                  Grid.Column="0"
                                                  AutomationProperties.Name="提醒小时"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledMinuteComboBox"
                                                  Grid.Column="2"
                                                  AutomationProperties.Name="提醒分钟"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#D59A61"
                                                   Text=":" />
                                        <ComboBox x:Name="ScheduledSecondComboBox"
                                                  Grid.Column="4"
                                                  AutomationProperties.Name="提醒秒"
                                                  Style="{StaticResource ScheduledTimePartComboBoxStyle}"
                                                  DropDownOpened="ScheduledTimePartComboBox_DropDownOpened"
                                                  DropDownClosed="ScheduledTimePartComboBox_DropDownClosed"
                                                  PreviewKeyDown="ScheduledTimePartComboBox_PreviewKeyDown"
                                                  SelectionChanged="ScheduledTimePartComboBox_SelectionChanged" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Height="28"
                                                Background="#FFFFF0DD"
                                                BorderBrush="#E7B77D"
                                                BorderThickness="1"
                                                Content="现在"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                Foreground="#A45F30"
                                                Click="ScheduledTimePickerNowButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="NowButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NowButtonBorder"
                                                                    Property="Background"
                                                                    Value="#FFFFE4C3" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Height="28"
                                                Background="#F2A65A"
                                                BorderThickness="0"
                                                Content="确定"
                                                Cursor="Hand"
                                                FontFamily="Microsoft YaHei"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Click="ScheduledTimePickerConfirmButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ConfirmButtonBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#F6B36F" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ConfirmButtonBorder"
                                                                    Property="Background"
                                                                    Value="#DE8F42" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                        <Button x:Name="ScheduledTaskSubmitButton"
                                Grid.Column="4"
                                Height="30"
                                Background="#F2A65A"
                                BorderThickness="0"
                                Content="设定"
                                Cursor="Hand"
                                FontFamily="Microsoft YaHei"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                ToolTip="添加定时任务"
                                Click="ScheduledTaskAddButton_Click" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScheduledTaskValidationText"
                                   Grid.Column="0"
                                   Height="18"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#C65353"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ScheduledRepeatRulePreviewText"
                                   Grid.Column="0"
                                   Height="18"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="10.5"
                                   Foreground="#A26D43"
                                   IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <Button x:Name="ScheduledTaskEditCancelButton"
                                Grid.Column="1"
                                MinWidth="31"
                                Height="18"
                                Margin="4,0,0,0"
                                Padding="2,0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="取消修改定时任务"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="取消"
                                Cursor="Hand"
                                FontFamily="Microsoft YaHei"
                                FontSize="10.5"
                                Foreground="#B47A4E"
                                ToolTip="取消修改"
                                Visibility="Collapsed"
                                Click="ScheduledTaskEditCancelButton_Click" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="EdgeRoamingToggle"
                              Grid.Column="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="绕屏动画"
                              Content="绕屏动画"
                              Cursor="Hand"
                              FontFamily="Microsoft YaHei"
                              FontSize="12"
                              Foreground="#515966"
                              IsChecked="True"
                              ToolTip="控制小鲁班是否自动绕着屏幕移动"
                              Checked="EdgeRoamingToggle_Changed"
                              Unchecked="EdgeRoamingToggle_Changed" />
                    <CheckBox x:Name="StartupToggle"
                              Grid.Column="1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="开机自启"
                              Content="开机自启"
                              Cursor="Hand"
                              FontFamily="Microsoft YaHei"
                              FontSize="12"
                              Foreground="#515966"
                              IsChecked="False"
                              ToolTip="登录 Windows 后自动启动小鲁班"
                              Checked="StartupToggle_Changed"
                              Unchecked="StartupToggle_Changed" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               Foreground="#515966"
                               Text="桌宠大小" />
                    <Slider x:Name="PetSizeSlider"
                            Grid.Column="1"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="Microsoft YaHei"
                            Minimum="75"
                            Maximum="140"
                            SnapsToDevicePixels="False"
                            TickFrequency="1"
                            UseLayoutRounding="False"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            SmallChange="1"
                            LargeChange="5"
                            ToolTip="默认 100% 比旧版高度增加约 1.5 厘米"
                            ValueChanged="PetSizeSlider_ValueChanged" />
                    <TextBlock x:Name="PetSizeLabel"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               Foreground="#515966"
                               TextAlignment="Right"
                               Text="100%" />
                </Grid>

            </Grid>
        </Border>

        <Grid x:Name="TailHost"
              Grid.Column="1"
              Margin="-1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Polygon x:Name="TailPolygon"
                     Points="0,0 12,9 0,18"
                     Fill="White"
                     Stroke="#D8DEE8"
                     StrokeThickness="1" />
        </Grid>

        <Popup x:Name="TaskFullTextPopup"
               AllowsTransparency="True"
               HorizontalOffset="12"
               Placement="MousePoint"
               PopupAnimation="Fade"
               StaysOpen="True"
               Opened="TaskFullTextPopup_Opened"
               Closed="TaskFullTextPopup_Closed">
            <Border Width="320"
                    MaxHeight="228"
                    Padding="11,9,11,10"
                    Background="#FFFEFEFF"
                    BorderBrush="#C9DCF7"
                    BorderThickness="1"
                    CornerRadius="13"
                    MouseEnter="TaskFullTextPopup_MouseEnter"
                    MouseLeave="TaskFullTextPopup_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      Opacity="0.18"
                                      ShadowDepth="3"
                                      Color="#5B6B86" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TaskFullTextTitle"
                               FontFamily="Microsoft YaHei"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#5B78A4"
                               Text="完整内容 · 可选择复制" />
                    <TextBox x:Name="TaskFullTextPreviewTextBox"
                             Grid.Row="1"
                             MinHeight="40"
                             MaxHeight="170"
                             Padding="7,5"
                             Background="White"
                             BorderBrush="#DFE9F7"
                             BorderThickness="1"
                             Cursor="IBeam"
                             FontFamily="Microsoft YaHei"
                             FontSize="12.5"
                             Foreground="#303744"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="TaskFullTextCountText"
                               Grid.Row="2"
                               Margin="1,2,1,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontFamily="Microsoft YaHei"
                               FontSize="10"
                               Foreground="#98A5B8" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
