                                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                        MaxHeight="132"
                                                        Margin="0,3,0,0"
                                                        Padding="3"
                                                        Background="#FFFFFCF7"
                                                        BorderBrush="#EAB777"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        SnapsToDevicePixels="True">
