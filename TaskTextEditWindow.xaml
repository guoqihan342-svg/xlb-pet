<Window x:Class="LubanDesktopPet.TaskTextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="修改内容"
        Width="378"
        Height="414"
        MinWidth="330"
        MinHeight="300"
        Background="#FFF6FAFF"
        FontFamily="Microsoft YaHei"
        Opacity="0"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="31"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="EditorBlueHoverBrush" Color="#DCEBFF" />
        <SolidColorBrush x:Key="EditorBluePrimaryHoverBrush" Color="#4F88DD" />
        <SolidColorBrush x:Key="EditorOrangeHoverBrush" Color="#FFE5C9" />
        <Style x:Key="EditorCuteButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Background" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#BBD3F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B6F9F" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Tag"
                    Value="{StaticResource EditorBlueHoverBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="EditorButtonRoot"
                              Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <Border x:Name="EditorHoverTint"
                                    Background="{TemplateBinding Tag}"
                                    CornerRadius="9"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Ellipse Width="12"
                                     Height="4"
                                     Margin="4,2,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Fill="#75FFFFFF"
                                     IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="EditorFocusRing"
                                    Margin="-2"
                                    BorderBrush="#6EA2E8"
                                    BorderThickness="1.5"
                                    CornerRadius="11"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Border x:Name="EditorPressedShade"
                                    Background="#16000000"
                                    CornerRadius="9"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditorHoverTint"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EditorButtonRoot"
                                        Property="Opacity"
                                        Value="0.96" />
                                <Setter TargetName="EditorPressedShade"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditorFocusRing"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EditorButtonRoot"
                                        Property="Opacity"
                                        Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#C5D9F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#6B82A2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="CloseCircle"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <Viewbox Width="9"
                                     Height="9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="9" Height="9">
                                    <Path Data="M1.3,1.3 L7.7,7.7 M7.7,1.3 L1.3,7.7"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.4" />
                                </Canvas>
                            </Viewbox>
                            <Ellipse x:Name="CloseFocusRing"
                                     Margin="-2"
                                     Fill="Transparent"
                                     Stroke="#6EA2E8"
                                     StrokeThickness="1.5"
                                     Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseCircle"
                                        Property="Fill"
                                        Value="#DDEBFF" />
                                <Setter Property="Foreground" Value="#3F6EA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseCircle"
                                        Property="Fill"
                                        Value="#C9DFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseFocusRing"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="10" Background="Transparent">
                            <Border Width="6"
                                    Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Background="#25A9C8EF"
                                    CornerRadius="3" />
                            <Track x:Name="PART_Track"
                                   Margin="1,3"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="EditorThumbPill"
                                                        Width="6"
                                                        Margin="0,1"
                                                        HorizontalAlignment="Center"
                                                        Background="#82ACE5"
                                                        CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="EditorThumbPill"
                                                                Property="Background"
                                                                Value="#679CDF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="EditorThumbPill"
                                                                Property="Background"
                                                                Value="#4E83C9" />
                                                        <Setter TargetName="EditorThumbPill"
                                                                Property="Width"
                                                                Value="7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="EditorChrome"
            Margin="0"
            Padding="12,10,12,12"
            BorderBrush="#AFCBEF"
            BorderThickness="1.2"
            CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.58" Color="#FFF8FBFF" />
                <GradientStop Offset="1" Color="#FFEDF5FF" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="22"
                            Height="22"
                            Margin="0,0,6,0"
                            Background="#E5F0FF"
                            BorderBrush="#BED5F3"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="13"
                                   Foreground="#4E7EBB"
                                   Text="✎" />
                    </Border>
                    <TextBlock x:Name="EditorTitleText"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#4C6487"
                               Text="修改内容" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="22"
                        Height="22"
                        Padding="0"
                        AutomationProperties.Name="取消修改"
                        FontFamily="Microsoft YaHei"
                        FontSize="16"
                        Style="{StaticResource EditorCloseButtonStyle}"
                        ToolTip="取消修改"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click" />
            </Grid>

            <TextBox x:Name="EditorTextBox"
                     Grid.Row="1"
                     Margin="0,8,0,8"
                     MinHeight="40"
                     Padding="10,8"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     FontFamily="Microsoft YaHei"
                     FontSize="12.5"
                     Foreground="#303744"
                     InputMethod.IsInputMethodEnabled="True"
                     MaxLength="5000"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                     TextChanged="EditorTextBox_TextChanged">
                <TextBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource EditorScrollBarStyle}" />
                </TextBox.Resources>
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Background" Value="#FFFEFEFF" />
                        <Setter Property="BorderBrush" Value="#D3E2F6" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="SelectionBrush" Value="#BDD7FA" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#72A5E8" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Margin="2,0,6,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CharacterCountText"
                               FontFamily="Microsoft YaHei"
                               FontSize="9.5"
                               Foreground="#98A5B8"
                               Text="0/5000" />
                    <TextBlock x:Name="SavePolicyHintText"
                               Margin="0,2,0,0"
                               FontFamily="Microsoft YaHei"
                               FontSize="9.5"
                               Foreground="#6F89AD"
                               Text="仅点击“确定修改”保存 · Esc 取消"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="仅点击“确定修改”保存 · Esc 取消" />
                </StackPanel>
                <Button x:Name="AdvancedEditButton"
                        Grid.Column="1"
                        Height="38"
                        Margin="0,0,8,0"
                        Padding="12,4"
                        Background="#FFF5E8"
                        BorderBrush="#E7C69E"
                        Content="时间与循环…"
                        FontSize="10"
                        Foreground="#A66B35"
                        Style="{StaticResource EditorCuteButtonStyle}"
                        Tag="{StaticResource EditorOrangeHoverBrush}"
                        Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="AdvancedEditButton_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        MinWidth="96"
                        Height="38"
                        Padding="14,4"
                        AutomationProperties.Name="确定修改"
                        Background="#6F9BE0"
                        BorderBrush="#5B87CA"
                        Content="确定修改"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Style="{StaticResource EditorCuteButtonStyle}"
                        Tag="{StaticResource EditorBluePrimaryHoverBrush}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SaveButton_Click" />
            </Grid>

        </Grid>
    </Border>
</Window>
