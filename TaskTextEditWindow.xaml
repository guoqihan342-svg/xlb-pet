<Window x:Class="LubanDesktopPet.TaskTextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="修改内容"
        Width="6cm"
        Height="3.708cm"
        MinWidth="190"
        MinHeight="124"
        Background="White"
        FontFamily="Microsoft YaHei"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="31"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="1"
            Padding="8,6,8,7"
            Background="White"
            BorderBrush="#C9DCF7"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              Direction="270"
                              Opacity="0.2"
                              ShadowDepth="3"
                              Color="#5B6B86" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="1,0,5,0"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="14"
                               Text="✎" />
                    <TextBlock x:Name="EditorTitleText"
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#4C6487"
                               Text="修改内容" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="×"
                        Cursor="Hand"
                        FontFamily="Microsoft YaHei"
                        FontSize="16"
                        Foreground="#96A3B6"
                        ToolTip="取消修改"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click" />
            </Grid>

            <TextBox x:Name="EditorTextBox"
                     Grid.Row="1"
                     MinHeight="40"
                     Padding="7,5"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     Background="#FFFEFEFF"
                     BorderBrush="#D9E5F6"
                     BorderThickness="1"
                     FontFamily="Microsoft YaHei"
                     FontSize="12.5"
                     Foreground="#303744"
                     InputMethod.IsInputMethodEnabled="True"
                     MaxLength="5000"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                     TextChanged="EditorTextBox_TextChanged" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CharacterCountText"
                           Margin="2,0,4,0"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei"
                           FontSize="9.5"
                           Foreground="#98A5B8"
                           Text="0/5000" />
                <Button x:Name="AdvancedEditButton"
                        Grid.Column="1"
                        Height="22"
                        Margin="0,0,5,0"
                        Padding="7,1"
                        Background="#FFF5E8"
                        BorderBrush="#E7C69E"
                        BorderThickness="1"
                        Content="时间与循环…"
                        Cursor="Hand"
                        FontFamily="Microsoft YaHei"
                        FontSize="10"
                        Foreground="#A66B35"
                        Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="AdvancedEditButton_Click" />
                <Button Grid.Column="2"
                        Height="22"
                        Padding="9,1"
                        Background="#6F9BE0"
                        BorderThickness="0"
                        Content="完成"
                        Cursor="Hand"
                        FontFamily="Microsoft YaHei"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="White"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SaveButton_Click" />
            </Grid>

            <Border Grid.RowSpan="3"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="SizeNWSE"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    shell:WindowChrome.ResizeGripDirection="BottomRight">
                <Path Width="9"
                      Height="9"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Data="M1,8 L8,1 M4,8 L8,4"
                      IsHitTestVisible="False"
                      Stroke="#B8C7DC"
                      StrokeEndLineCap="Round"
                      StrokeThickness="1.1" />
            </Border>
        </Grid>
    </Border>
</Window>
