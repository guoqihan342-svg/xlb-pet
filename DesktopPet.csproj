<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LubanDesktopPet</RootNamespace>
    <AssemblyName>LubanDesktopPet</AssemblyName>
    <Version>1.0.57</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\luban-tray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\sprite-pages\*.pbgra.br" />
    <Resource Include="Assets\luban-sprite-pages.json" />
    <Resource Include="Assets\luban-pillow-layer.png" />
    <EmbeddedResource Include="Assets\luban-tray.ico"
                      LogicalName="LubanDesktopPet.Assets.luban-tray.ico" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
